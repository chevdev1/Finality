---
import VerificationMeter from './VerificationMeter.astro';
import ArticleSeal from './ArticleSeal.astro';
import { fetchThemedPhoto } from '../lib/pexels-client';
import type { Locale } from '../lib/i18n';

interface Props {
  title: string;
  dek?: string;
  href: string;
  section: string;
  publishedAt: Date;
  checksCount: number;
  slug: string;
  imageQuery?: string;
  locale?: Locale;
}

const { title, dek, href, section, publishedAt, checksCount, slug, imageQuery, locale = 'ru' } = Astro.props;
const meterLabel = locale === 'en' ? `${checksCount} of 6 checks passed` : `${checksCount} из 6 проверок пройдено`;

// Same cache the article page itself reads from (keyed by query string) — by the time any
// list view renders, the photo for a given article has usually already been fetched once
// for its own page this build, so this is a cache hit, not a second Pexels request.
const photo = imageQuery ? await fetchThemedPhoto(imageQuery) : null;

// Every article's publishedAt frontmatter is set to 00:00 UTC (an arbitrary editorial
// timestamp, not a real time-of-day) — showing HH:MM here just repeated "00:00" down an
// entire feed, reading like an unfilled placeholder rather than real data. The date is the
// part that's actually true and actually useful when scanning weeks of articles.
function fmtDate(d: Date) {
  return d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit' });
}
---

<a class="row" href={href} data-row data-name={title} data-category={section}>
  <span class="thumb">
    {photo ? (
      <img src={photo.thumb} alt="" loading="lazy" width="120" height="120" />
    ) : (
      <ArticleSeal seed={slug} cols={4} rows={4} />
    )}
  </span>
  <span class="data time">{fmtDate(publishedAt)}</span>
  <span class="meter"><VerificationMeter filled={checksCount} size={10} label={meterLabel} /></span>
  <span class="body">
    <span class="title">{title}</span>
    {dek && <span class="dek">{dek}</span>}
  </span>
  <span class="kicker section">{section}</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 76px 52px 90px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  /* .row's own display:grid is author CSS at the same specificity as the UA's
     [hidden]{display:none} — author beats user-agent at a tie, so FilterBar.astro setting
     .hidden on a row (as used on the homepage feed) silently did nothing visually, even
     though the attribute itself was set correctly. An explicit, higher-specificity rule for
     the hidden state is the fix already used elsewhere in this codebase for the same clash. */
  .row[hidden] {
    display: none;
  }
  .thumb {
    width: 76px;
    height: 76px;
    border: 1px solid var(--rule);
    background: var(--paper);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
  }
  /* A dozen different stock photographers' colors and crops, shrunk to 76px, read as noisy
     and cheap sitting next to a serif headline — the same problem newspapers solved with a
     house duotone rather than running photos as-shot. Desaturating plus a touch of warmth
     (sepia) ties every photo to the page's own ink/cream palette instead of fighting it;
     full color returns on hover as the reward for engaging, not the resting state. */
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(75%) sepia(8%) contrast(1.05);
    transition: filter 200ms ease, transform 200ms var(--ease-standard);
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover .thumb img {
      filter: grayscale(0%) sepia(0%) contrast(1);
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb img {
      transition: filter 200ms ease;
      transform: none;
    }
    .row:hover .thumb img {
      transform: none;
    }
  }
  .thumb :global(.seal) {
    height: 100%;
    max-height: none;
    border: none;
  }
  .title {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .title {
      transition: text-decoration-color 150ms ease;
    }
    .row:hover .title {
      text-decoration-color: var(--pending);
    }
  }
  .body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .title {
    font-weight: 700;
    font-size: 17px;
  }
  .dek {
    color: var(--graphite);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .section {
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 56px 1fr;
      grid-template-areas:
        'thumb body'
        'thumb section';
      gap: 4px 12px;
    }
    .thumb {
      grid-area: thumb;
      width: 56px;
      height: 56px;
      align-self: start;
    }
    .time,
    .meter {
      display: none;
    }
    .body {
      grid-area: body;
    }
    .section {
      grid-area: section;
      justify-self: start;
    }
  }
</style>
