---
interface Props {
  project: string;
  tagline: string;
  href: string;
  guestColor: string;
  logo?: string;
}
const { project, tagline, href, guestColor, logo } = Astro.props;
---

<a class="teaser" href={href} rel="sponsored" style={`--guest: ${guestColor}`}>
  <span class="badge">Партнёрский материал</span>
  <span class="row">
    <span class="tile" aria-hidden="true">
      {logo ? <img src={logo} alt="" width="28" height="28" /> : project.replace('[', '').charAt(0)}
    </span>
    <span class="name">{project}</span>
  </span>
  <span class="tagline">{tagline}</span>
</a>

<style>
  .teaser {
    display: grid;
    gap: 8px;
    border: 1px solid color-mix(in srgb, var(--guest) 45%, var(--rule));
    padding: 16px;
    text-decoration: none;
    color: var(--ink);
    background: linear-gradient(165deg, color-mix(in srgb, var(--guest) 10%, var(--paper)), var(--paper) 70%);
  }
  .badge {
    font-family: var(--font-data);
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--guest);
    font-weight: 700;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tile {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--guest);
    color: #fff;
    font-weight: 700;
    font-family: var(--font-body);
    flex-shrink: 0;
    overflow: hidden;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .name {
    font-weight: 700;
  }
  .tagline {
    font-size: 13px;
    color: var(--graphite);
  }
  @media (hover: hover) and (pointer: fine) {
    .teaser:hover {
      background: linear-gradient(165deg, color-mix(in srgb, var(--guest) 18%, var(--paper)), var(--paper) 70%);
    }
  }
</style>
