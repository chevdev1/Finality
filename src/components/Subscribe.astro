---
import { UI, type Locale } from '../lib/i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'ru' } = Astro.props;
const t = UI[locale];
---
<form class="subscribe" data-subscribe-form>
  <span class="label">{t.subscribeLabel}</span>
  <p class="sub">{t.subscribeSub}</p>
  <div class="row">
    <input type="email" name="email" required placeholder="you@example.com" aria-label={t.subscribeEmailAria} />
    <button type="submit">{t.subscribeButton}</button>
  </div>
</form>

<div class="toast" data-toast hidden role="status">{t.subscribeToast}</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-subscribe-form]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.reset();
    toast?.removeAttribute('hidden');
    toast?.classList.add('in');
    setTimeout(() => {
      toast?.classList.remove('in');
      setTimeout(() => toast?.setAttribute('hidden', ''), 150);
    }, 2200);
  });
</script>

<style>
  .subscribe {
    background: var(--pending);
    padding: 20px;
    display: grid;
    gap: 6px;
  }
  /* .label/.sub sit directly on the constant-yellow --pending fill, so they need the fixed
     --on-accent, not var(--ink) (flips to near-white in dark mode — white-on-yellow, a real
     WCAG failure) or inherited body color. The submit button below has its own background
     (var(--ink)) and correctly keeps following the theme, so this fix is scoped to just
     these two text lines rather than the whole .subscribe container. */
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--on-accent);
  }
  .sub {
    margin: 0 0 8px;
    font-size: 13px;
    color: var(--on-accent);
  }
  .row {
    display: flex;
    gap: 8px;
  }
  input[type='email'] {
    flex: 1;
    padding: 10px;
    border: 1px solid var(--on-accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    min-width: 0;
  }
  button[type='submit'] {
    background: var(--ink);
    color: var(--ledger);
    border: none;
    padding: 10px 16px;
    font-weight: 700;
    white-space: nowrap;
  }
  button[type='submit']:active {
    transform: scale(0.97);
    transition: transform 120ms var(--ease-standard);
  }
  .toast {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translate(-50%, 0);
    background: var(--ink);
    color: var(--ledger);
    padding: 12px 20px;
    font-weight: 700;
    z-index: 50;
    opacity: 0;
    transition: opacity 150ms var(--ease-standard), transform 150ms var(--ease-standard);
  }
  .toast.in {
    opacity: 1;
    transform: translate(-50%, -8px);
    transition-duration: 200ms;
  }
</style>
