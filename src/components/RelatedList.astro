---
import VerificationMeter from './VerificationMeter.astro';

interface Item {
  title: string;
  href: string;
  section: string;
  checksCount: number;
}
interface Props {
  items: Item[];
  heading?: string;
  locale?: 'ru' | 'en';
}
const { items, heading = 'Связанные материалы', locale = 'ru' } = Astro.props;
const meterLabel = (n: number) => (locale === 'en' ? `${n} of 6 checks passed` : `${n} из 6 проверок пройдено`);
---

{items.length > 0 && (
  <div class="related">
    <span class="kicker heading">{heading}</span>
    {items.map((i) => (
      <a class="item" href={i.href}>
        <VerificationMeter filled={i.checksCount} size={9} label={meterLabel(i.checksCount)} />
        <span class="title">{i.title}</span>
      </a>
    ))}
  </div>
)}

<style>
  .related {
    display: grid;
    gap: 14px;
  }
  .heading {
    color: var(--graphite);
  }
  .item {
    display: grid;
    gap: 6px;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .title {
    font-weight: 700;
    font-size: 15px;
  }
</style>
