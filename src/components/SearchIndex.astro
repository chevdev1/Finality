---
import { getCollection } from 'astro:content';
import { SECTION_LABELS } from '../lib/labels';
import { SECTION_LABELS_EN, UI, type Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ru' } = Astro.props;
const t = UI[locale];
const sectionLabels = locale === 'en' ? SECTION_LABELS_EN : SECTION_LABELS;

const kindLabel = locale === 'en'
  ? { calendar: 'Calendar', regulation: 'Tracker', glossary: 'Glossary' }
  : { calendar: 'Календарь', regulation: 'Трекер', glossary: 'Глоссарий' };

const news = await getCollection('news');
// Indexes dek alongside title now — searching only titles meant a reader who remembered a
// fact or number from an article's lead, but not its exact headline wording, found nothing.
const articleItems = news.map((n) => ({
  title: locale === 'en' ? (n.data.title_en ?? n.data.title) : n.data.title,
  dek: locale === 'en' ? (n.data.dek_en ?? n.data.dek) : n.data.dek,
  section: sectionLabels[n.data.section],
  url: `/${n.data.section}/${n.id}/`,
}));

// The site grew three more real destinations (Calendar, Regulatory Tracker, Glossary) since
// search was first built, and none of them were ever added to the index — a reader searching
// "CLARITY" or "TVL" found only news articles mentioning the word, never the calendar entry,
// tracker row, or glossary definition that's arguably the more relevant hit. `section` doubles
// as the result kicker for every item type, so these just carry the destination's name there.
const events = await getCollection('events');
const calendarHref = locale === 'en' ? '/en/calendar/' : '/calendar/';
const calendarItems = events.map((e) => ({
  title: locale === 'en' ? (e.data.title_en ?? e.data.title) : e.data.title,
  dek: locale === 'en' ? (e.data.description_en ?? e.data.description) : e.data.description,
  section: kindLabel.calendar,
  url: calendarHref,
}));

const regulations = await getCollection('regulations');
const regulationHref = locale === 'en' ? '/en/regulation/' : '/regulation/';
const regulationItems = regulations.map((r) => ({
  title: locale === 'en' ? (r.data.name_en ?? r.data.name) : r.data.name,
  dek: locale === 'en' ? (r.data.summary_en ?? r.data.summary) : r.data.summary,
  section: kindLabel.regulation,
  url: regulationHref,
}));

const glossary = await getCollection('glossary');
const glossaryHref = locale === 'en' ? '/en/glossary/' : '/glossary/';
const glossaryItems = glossary.map((g) => ({
  title: locale === 'en' ? (g.data.term_en ?? g.data.term) : g.data.term,
  dek: locale === 'en' ? (g.data.definition_en ?? g.data.definition) : g.data.definition,
  section: kindLabel.glossary,
  url: `${glossaryHref}#${g.id}`,
}));

const index = [...articleItems, ...calendarItems, ...regulationItems, ...glossaryItems];
---

<script type="application/json" id="search-index" set:html={JSON.stringify(index)} />

<div class="search-overlay" data-search-overlay hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label={t.search}>
    <input type="text" data-search-input placeholder={t.searchPlaceholder} autocomplete="off" />
    <div class="results" data-search-results data-no-results={t.searchNoResults}></div>
    <p class="hint">{t.searchClose}</p>
  </div>
</div>

<script>
  // open/close/render always re-query the live DOM rather than closing over elements
  // captured once — that's what lets the single, page-load-spanning keydown listener below
  // stay correct after a <ClientRouter /> navigation swaps in a whole new overlay/input/
  // results triplet (and a new per-page search-index dataset) without needing to know
  // about it.
  function getOverlay() {
    return document.querySelector<HTMLElement>('[data-search-overlay]');
  }
  function getInput() {
    return document.querySelector<HTMLInputElement>('[data-search-input]');
  }
  function getResults() {
    return document.querySelector<HTMLElement>('[data-search-results]');
  }

  function open() {
    getOverlay()?.removeAttribute('hidden');
    getInput()?.focus();
  }
  function close() {
    getOverlay()?.setAttribute('hidden', '');
    const input = getInput();
    if (input) input.value = '';
    render([], '');
  }
  function render(items: { title: string; dek: string; section: string; url: string }[], query: string) {
    const results = getResults();
    if (!results) return;
    if (query && items.length === 0) {
      results.innerHTML = `<p class="no-results">${results.dataset.noResults ?? ''}</p>`;
      return;
    }
    results.innerHTML = items
      .slice(0, 8)
      .map(
        (i) =>
          `<a href="${i.url}"><span class="kicker">${i.section}</span><span>${i.title}</span></a>`
      )
      .join('');
  }

  // Attached exactly once for the whole session — document itself isn't replaced by
  // <ClientRouter />, so re-registering this on every 'astro:page-load' would stack up one
  // duplicate keydown handler per navigation (each firing open()/close() again on the same
  // keypress).
  if (!window.__financeSearchKeysInit) {
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === 'Escape') close();
    });
    window.__financeSearchKeysInit = true;
  }

  declare global {
    interface Window {
      __financeSearchKeysInit?: boolean;
    }
  }

  // Everything below IS page-specific (this page's own search-index dataset, this page's
  // own overlay/input/trigger elements) and must be re-wired on every navigation.
  document.addEventListener('astro:page-load', () => {
    const overlay = getOverlay();
    const input = getInput();
    const dataEl = document.getElementById('search-index');
    const index: { title: string; dek: string; section: string; url: string }[] = dataEl
      ? JSON.parse(dataEl.textContent || '[]')
      : [];

    document.querySelectorAll('[data-search-trigger]').forEach((el) => el.addEventListener('click', open));
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    input?.addEventListener('input', () => {
      const raw = input.value.trim();
      if (!raw) return render([], '');
      // Split into words and require every one to appear somewhere in title+dek, in any
      // order — a plain substring match on the whole query missed "trump genius" against a
      // title like "Trump signs GENIUS Act" (right words, wrong order) and anything where the
      // reader's word order just didn't match the headline's.
      const words = raw.toLowerCase().split(/\s+/).filter(Boolean);
      render(
        index.filter((i) => {
          const haystack = `${i.title} ${i.dek}`.toLowerCase();
          return words.every((w) => haystack.includes(w));
        }),
        raw
      );
    });
  });
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 22, 19, 0.5);
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    z-index: 100;
  }
  .search-overlay:not([hidden]) {
    display: flex;
  }
  .search-panel {
    background: var(--paper);
    width: min(560px, 92vw);
    padding: 16px;
    border: 1px solid var(--rule);
  }
  input[data-search-input] {
    width: 100%;
    font-family: var(--font-body);
    font-size: 18px;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
  }
  input[data-search-input]:focus {
    border-bottom-color: var(--ink);
  }
  .results {
    display: grid;
  }
  .results a {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    padding: 10px 8px;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .results a:hover {
    background: var(--ledger);
  }
  .hint {
    margin: 10px 8px 0;
    font-size: 11px;
    color: var(--graphite);
  }
  .no-results {
    margin: 0;
    padding: 16px 8px;
    color: var(--graphite);
    font-size: 14px;
  }
</style>
