---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="takeaways">
  <span class="kicker">Главное</span>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .takeaways {
    border: 1px solid var(--rule);
    border-left: 4px solid var(--ink);
    background: var(--paper);
    padding: 16px 20px;
    display: grid;
    gap: 10px;
  }
  ul {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  li {
    font-size: 15px;
  }
</style>
