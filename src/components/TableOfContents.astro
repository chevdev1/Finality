---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 1 && (
  <details class="toc" open>
    <summary>На этой странице</summary>
    <nav>
      <ol>
        {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  </details>
)}

<style>
  .toc {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 14px 16px;
  }
  summary {
    cursor: pointer;
    font-family: var(--font-data);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--graphite);
  }
  ol {
    margin: 12px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  a {
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
  }
  a:hover {
    text-decoration: underline;
  }

  /* The <details> ships with `open` set unconditionally now — on both mobile and desktop.
     An earlier version relied on CSS to force the nav visible while <details> stayed
     closed (no `open` attribute), overriding the UA's
     "details:not([open]) > *:not(summary) { display: none }" rule. That's not just a
     specificity fight to win: in Chromium (and per the current <details> content model),
     a closed details element's non-summary content doesn't participate in normal layout
     sizing even once you force its `display` back — the child renders and reports a real
     getBoundingClientRect, but the <details> box itself refuses to grow to contain it,
     collapsing to just its padding. That's exactly the empty rectangle a user spotted and
     flagged as a rendering bug. Forcing `open` in markup sidesteps the whole class of
     problem: the content is in normal, native, unhacked flow at every width. Mobile's
     "collapsed by default" behavior is gone as a result — a short on-page nav visible by
     default isn't a real loss, and the disclosure is still genuinely interactive (tap the
     summary to collapse it, which is what it visually invites now instead of expanding). */
  @media (min-width: 901px) {
    summary {
      display: none;
    }
    .toc {
      position: sticky;
      top: 72px;
    }
    ol {
      margin-top: 0;
    }
  }
</style>
