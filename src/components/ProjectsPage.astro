---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SpotlightTeaser from './SpotlightTeaser.astro';
import FilterBar from './FilterBar.astro';
import type { Locale } from '../lib/i18n';
import {
  fetchTopChains,
  fetchTopProtocols,
  fetchTopGainers,
  fetchTvlHistory,
  sparklinePath,
  chainIconUrl,
  chainPageUrl,
  fmtTvl,
  fmtChange,
  fmtDate,
  type ProtocolTvl,
} from '../lib/defillama-client';

interface Props {
  locale?: Locale;
}
const { locale = 'ru' } = Astro.props;

const RU = {
  pageTitle: 'Проекты — Finality',
  pageDescription: 'Рейтинг блокчейнов и протоколов по объёму заблокированных средств (TVL), с источником у каждой цифры.',
  jsonLdName: 'Проекты — Finality',
  jsonLdAbout: 'Рейтинг блокчейнов и протоколов по TVL',
  home: 'Finality',
  crumbsCurrent: 'Проекты',
  h1: 'Проекты',
  intro: 'Блокчейны и протоколы, отсортированные по объёму заблокированных средств (TVL). Разница в TVL за 24 часа — не то же самое, что рост числа пользователей, но это единственная метрика здесь, у которой есть открытый, проверяемый источник у каждой строки. Строки протоколов раскрываются — внутри описание, разбивка TVL по сетям и заметные события проекта.',
  statTvlLabel: 'Суммарный TVL, топ-10 сетей',
  statTvlHint: 'Сумма TVL по методологии DeFiLlama: залоги, депозиты и застейканные активы во всех отслеживаемых протоколах каждой сети. Не рыночная капитализация.',
  statProtocolsLabel: 'Протоколов в рейтинге',
  statUpdatedLabel: 'Обновлено',
  statSourceLabel: 'Источник',
  viewControlsAria: 'Вид отображения протоколов',
  viewTable: 'Таблица',
  viewCards: 'Карточки',
  chainsHeading: 'Топ блокчейнов по TVL',
  chainsNote: 'Строка ведёт на страницу сети в DeFiLlama.',
  protocolsHeading: 'Топ протоколов по TVL',
  protocolsNote: 'Клик по строке разворачивает карточку проекта.',
  gainersHeading: 'Актуальные проекты — лидеры роста TVL за 24ч',
  gainersNote: 'Только протоколы с TVL от $5 млн — иначе рост в процентах ничего не значит.',
  emptyState: 'DeFiLlama не ответила при сборке страницы. Данные обновятся при следующей публикации.',
  findProtocol: 'Найти протокол…',
  findProject: 'Найти проект…',
  network: 'сеть',
  networks: 'сетей',
  category: 'Категория',
  delta7d: 'Δ7 дней',
  audits: 'Аудиты',
  auditsNotFound: 'не найдены',
  listedSince: 'В реестре с',
  tvl30d: 'TVL, 30 дней',
  tvlByChain: 'TVL по сетям',
  hallmarksLabel: 'Заметные события',
  siteLink: 'Сайт проекта ↗',
  twitterLink: 'X (Twitter) ↗',
  auditReportLink: 'Отчёт аудита ↗',
  fullCardLink: 'Полная карточка на DeFiLlama ↗',
  disclaimer: 'Данные получены при последней сборке страницы. Не инвестиционная рекомендация.',
  editorialLabel: 'Материал редакции',
  editorialCopy: 'Разбор без спонсора: как читать TVL, аудиты и дату листинга, прежде чем доверять протоколу деньги.',
  editorialLink: 'Читать раздел «DeFi» ↗',
  projectOfDayLabel: 'Проект дня — лидер роста TVL за 24ч',
  projectOfDayNote: (tvl: string, count: number) =>
    `TVL ${tvl} на ${count} ${count === 1 ? 'сети' : 'сетях'} — самый быстрый рост за последние 24 часа среди протоколов с TVL от $5 млн.`,
  newlyListedLabel: 'Новые в реестре DeFiLlama',
};

const EN = {
  pageTitle: 'Projects — Finality',
  pageDescription: 'A ranking of blockchains and protocols by total value locked (TVL), with a source behind every number.',
  jsonLdName: 'Projects — Finality',
  jsonLdAbout: 'Ranking of blockchains and protocols by TVL',
  home: 'Finality',
  crumbsCurrent: 'Projects',
  h1: 'Projects',
  intro: "Blockchains and protocols sorted by total value locked (TVL). A 24-hour TVL swing isn't the same as user growth, but it's the one metric here with an open, checkable source behind every row. Protocol rows expand to show a description, a TVL breakdown by chain, and notable project milestones.",
  statTvlLabel: 'Combined TVL, top 10 networks',
  statTvlHint: "Sum of TVL under DeFiLlama's methodology: collateral, deposits, and staked assets across every tracked protocol on each network. Not market capitalization.",
  statProtocolsLabel: 'Protocols ranked',
  statUpdatedLabel: 'Updated',
  statSourceLabel: 'Source',
  viewControlsAria: 'Protocol display view',
  viewTable: 'Table',
  viewCards: 'Cards',
  chainsHeading: 'Top blockchains by TVL',
  chainsNote: "Each row links to the network's page on DeFiLlama.",
  protocolsHeading: 'Top protocols by TVL',
  protocolsNote: "Click a row to expand the project's card.",
  gainersHeading: 'Trending projects — top 24h TVL gainers',
  gainersNote: "Only protocols with at least $5M in TVL — otherwise a percentage gain doesn't mean much.",
  emptyState: "DeFiLlama didn't respond while the page was being built. Data will refresh on the next publish.",
  findProtocol: 'Find a protocol…',
  findProject: 'Find a project…',
  network: 'network',
  networks: 'networks',
  category: 'Category',
  delta7d: 'Δ7 days',
  audits: 'Audits',
  auditsNotFound: 'none found',
  listedSince: 'Listed since',
  tvl30d: 'TVL, 30 days',
  tvlByChain: 'TVL by chain',
  hallmarksLabel: 'Notable events',
  siteLink: 'Project website ↗',
  twitterLink: 'X (Twitter) ↗',
  auditReportLink: 'Audit report ↗',
  fullCardLink: 'Full profile on DeFiLlama ↗',
  disclaimer: "Data captured at the page's last build. Not investment advice.",
  editorialLabel: 'Editorial pick',
  editorialCopy: 'An unsponsored breakdown: how to read TVL, audits, and listing dates before trusting a protocol with your money.',
  editorialLink: 'Read the DeFi section ↗',
  projectOfDayLabel: 'Project of the day — top 24h TVL gainer',
  projectOfDayNote: (tvl: string, count: number) =>
    `TVL ${tvl} across ${count} ${count === 1 ? 'network' : 'networks'} — the fastest 24-hour gain among protocols with at least $5M in TVL.`,
  newlyListedLabel: 'Newly listed on DeFiLlama',
};

const P = locale === 'en' ? EN : RU;
const homeHref = locale === 'en' ? '/en/' : '/';
const dfLocale = locale === 'en' ? 'en' : 'ru';

const [chains, protocols, gainers] = await Promise.all([
  fetchTopChains(10),
  fetchTopProtocols(15),
  fetchTopGainers(10),
]);

// One history fetch per unique protocol slug, not per row — the same protocol often shows up
// in both the TVL table and the gainers table, and /protocol/{slug} is a much heavier request
// than the two list endpoints above (it returns years of history to get 30 days out of it).
const slugsNeedingHistory = [...new Set([...protocols, ...gainers].map((p) => p.slug).filter((s): s is string => !!s))];
const historyBySlug = new Map(
  await Promise.all(
    slugsNeedingHistory.map(async (slug) => [slug, await fetchTvlHistory(slug, 30)] as const)
  )
);
function sparkFor(slug: string | null) {
  if (!slug) return null;
  return sparklinePath(historyBySlug.get(slug) ?? []);
}

const totalTvl = chains.reduce((sum, c) => sum + c.tvl, 0);
const spotlights = await getCollection('spotlight');
// project-template.md ships in the repo as a filled-in example for whoever writes the next
// Spotlight, not something to publish — any bracketed field means it's still a template, and
// showing it to a reader looks like a live, sold placement that doesn't exist.
const spotlight = spotlights.find((s) => !s.data.project.includes('['));

const buildTime = new Date().toLocaleTimeString(locale === 'en' ? 'en-US' : 'ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';

// "Project of the day" — the single biggest 24h TVL gainer already computed for the third
// table, reused rather than invented as a separate metric.
const projectOfDay = gainers[0];

// "Новые в рейтинге" — protocols DeFiLlama itself has dated as newest additions to its
// tracked list. Real field (listedAt), not a fabricated "trending" claim.
const newlyListed = [...protocols, ...gainers]
  .filter((p, i, arr) => arr.findIndex((x) => x.name === p.name) === i && p.listedAt)
  .sort((a, b) => (b.listedAt ?? 0) - (a.listedAt ?? 0))
  .slice(0, 4);

function protocolPageUrl(p: ProtocolTvl) {
  return p.slug ? `https://defillama.com/protocol/${p.slug}` : 'https://defillama.com';
}

// Categories come straight from DeFiLlama's own `category` field — real values already in
// the data (Lending, CEX, Liquid Staking...), not an invented taxonomy. Computed per table
// so the chip list never offers a category with zero matching rows in that specific table.
const protocolCategories = [...new Set(protocols.map((p) => p.category))].sort();
const gainerCategories = [...new Set(gainers.map((p) => p.category))].sort();
---

<BaseLayout
  locale={locale}
  title={P.pageTitle}
  description={P.pageDescription}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: P.jsonLdName,
      about: P.jsonLdAbout,
    },
  ]}
>
  <div class="wrap page">
    <nav class="crumbs"><a href={homeHref}>{P.home}</a> / {P.crumbsCurrent}</nav>
    <h1 class="title">{P.h1}</h1>
    <p class="intro">{P.intro}</p>

    <div class="stats">
      <div class="stat">
        <span class="kicker">
          {P.statTvlLabel}
          <span class="hint" tabindex="0">
            <span aria-hidden="true">?</span>
            <span class="hint-body" role="tooltip">{P.statTvlHint}</span>
          </span>
        </span>
        <span class="data value">{fmtTvl(totalTvl, dfLocale)}</span>
      </div>
      <div class="stat">
        <span class="kicker">{P.statProtocolsLabel}</span>
        <span class="data value">{protocols.length}</span>
      </div>
      <div class="stat">
        <span class="kicker">{P.statUpdatedLabel}</span>
        <span class="data value updated-value">{buildTime}</span>
      </div>
      <div class="stat">
        <span class="kicker">{P.statSourceLabel}</span>
        <span class="value"><a href="https://defillama.com" target="_blank" rel="noopener">DeFiLlama ↗</a></span>
      </div>
    </div>

    <div class="view-controls" role="radiogroup" aria-label={P.viewControlsAria}>
      <input type="radio" name="view" id="view-table" class="visually-hidden" checked />
      <label for="view-table">{P.viewTable}</label>
      <input type="radio" name="view" id="view-cards" class="visually-hidden" />
      <label for="view-cards">{P.viewCards}</label>
    </div>

    <div class="layout">
      <div class="main">
        <section class="block">
          <div class="block-head">
            <h2>{P.chainsHeading}</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">{P.chainsNote}</p>
          {chains.length === 0 && (
            <p class="empty-state">{P.emptyState}</p>
          )}
          <div class="table">
            {chains.map((c, i) => (
              <a class="row chain-row" href={chainPageUrl(c.name)} target="_blank" rel="noopener">
                <span class="rank data">{i + 1}</span>
                <span class="proto">
                  <span class="icon">
                    <img src={chainIconUrl(c.name)} width="16" height="16" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />
                  </span>
                  <span class="name">{c.name}</span>
                </span>
                <span class="tvl data">{fmtTvl(c.tvl, dfLocale)}</span>
                <span class="external" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>{P.protocolsHeading}</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">{P.protocolsNote}</p>
          {protocols.length === 0 && (
            <p class="empty-state">{P.emptyState}</p>
          )}
          {protocols.length > 0 && <FilterBar categories={protocolCategories} placeholder={P.findProtocol} locale={locale} />}
          <div class="table protocol-table">
            {protocols.map((p, i) => (
              <details class="row proto-row" name="protocols-table" data-row data-name={p.name} data-category={p.category}>
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="18" height="18" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? P.network : P.networks}</span>
                  <span class="tvl data">{fmtTvl(p.tvl, dfLocale)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class:list={['chg', 'week', 'data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_7d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">⌄</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}

                    <div class="detail-grid">
                      <div><span class="kicker">{P.category}</span><span>{p.category}</span></div>
                      <div><span class="kicker">{P.delta7d}</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">{P.audits}</span><span>{p.audits === '0' ? P.auditsNotFound : p.audits}</span></div>
                      {fmtDate(p.listedAt, dfLocale) && <div><span class="kicker">{P.listedSince}</span><span class="data">{fmtDate(p.listedAt, dfLocale)}</span></div>}
                    </div>

                    {(() => {
                      const spark = sparkFor(p.slug);
                      return (
                        spark && (
                          <div class="sparkline-row">
                            <span class="kicker">{P.tvl30d}</span>
                            <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                              <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                            </svg>
                          </div>
                        )
                      );
                    })()}

                    {p.chainBreakdown.length > 0 && (
                      <div class="chain-breakdown">
                        <span class="kicker">{P.tvlByChain}</span>
                        {p.chainBreakdown.map((cb) => (
                          <div class="bar-row">
                            <span class="bar-label">{cb.chain}</span>
                            <div class="bar-track">
                              <div class="bar-fill" style={`width:${Math.max(4, (cb.tvl / p.chainBreakdown[0].tvl) * 100)}%`} />
                            </div>
                            <span class="data bar-value">{fmtTvl(cb.tvl, dfLocale)}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {p.hallmarks.length > 0 && (
                      <div class="hallmarks">
                        <span class="kicker">{P.hallmarksLabel}</span>
                        <ul>
                          {p.hallmarks.slice(0, 4).map((h) => (
                            <li><span class="data hallmark-date">{fmtDate(h.at, dfLocale)}</span><span>{h.label}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">{P.siteLink}</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">{P.twitterLink}</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">{P.auditReportLink}</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">{P.fullCardLink}</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
          <div class="cards protocol-cards">
            {protocols.map((p, i) => {
              const spark = sparkFor(p.slug);
              return (
                <a class="proto-card" href={protocolPageUrl(p)} target="_blank" rel="noopener">
                  <div class="card-top">
                    <span class="rank data">{i + 1}</span>
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="24" height="24" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <div class="card-name-wrap">
                      <span class="card-name">{p.name}</span>
                      <span class="kicker cat">{p.category}</span>
                    </div>
                  </div>
                  <div class="card-nums">
                    <span class="data card-tvl">{fmtTvl(p.tvl, dfLocale)}</span>
                    <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_1d)}</span>
                  </div>
                  {spark && (
                    <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                      <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                    </svg>
                  )}
                  {p.description && <p class="card-desc">{p.description}</p>}
                </a>
              );
            })}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>{P.gainersHeading}</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">{P.gainersNote}</p>
          {gainers.length === 0 && (
            <p class="empty-state">{P.emptyState}</p>
          )}
          {gainers.length > 0 && <FilterBar categories={gainerCategories} placeholder={P.findProject} locale={locale} />}
          <div class="table protocol-table">
            {gainers.map((p, i) => (
              <details class="row proto-row" name="gainers-table" data-row data-name={p.name} data-category={p.category}>
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="18" height="18" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? P.network : P.networks}</span>
                  <span class="tvl data">{fmtTvl(p.tvl, dfLocale)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class:list={['chg', 'week', 'data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_7d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">⌄</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}

                    <div class="detail-grid">
                      <div><span class="kicker">{P.category}</span><span>{p.category}</span></div>
                      <div><span class="kicker">{P.delta7d}</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">{P.audits}</span><span>{p.audits === '0' ? P.auditsNotFound : p.audits}</span></div>
                      {fmtDate(p.listedAt, dfLocale) && <div><span class="kicker">{P.listedSince}</span><span class="data">{fmtDate(p.listedAt, dfLocale)}</span></div>}
                    </div>

                    {(() => {
                      const spark = sparkFor(p.slug);
                      return (
                        spark && (
                          <div class="sparkline-row">
                            <span class="kicker">{P.tvl30d}</span>
                            <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                              <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                            </svg>
                          </div>
                        )
                      );
                    })()}

                    {p.chainBreakdown.length > 0 && (
                      <div class="chain-breakdown">
                        <span class="kicker">{P.tvlByChain}</span>
                        {p.chainBreakdown.map((cb) => (
                          <div class="bar-row">
                            <span class="bar-label">{cb.chain}</span>
                            <div class="bar-track">
                              <div class="bar-fill" style={`width:${Math.max(4, (cb.tvl / p.chainBreakdown[0].tvl) * 100)}%`} />
                            </div>
                            <span class="data bar-value">{fmtTvl(cb.tvl, dfLocale)}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {p.hallmarks.length > 0 && (
                      <div class="hallmarks">
                        <span class="kicker">{P.hallmarksLabel}</span>
                        <ul>
                          {p.hallmarks.slice(0, 4).map((h) => (
                            <li><span class="data hallmark-date">{fmtDate(h.at, dfLocale)}</span><span>{h.label}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">{P.siteLink}</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">{P.twitterLink}</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">{P.auditReportLink}</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">{P.fullCardLink}</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
          <div class="cards protocol-cards">
            {gainers.map((p, i) => {
              const spark = sparkFor(p.slug);
              return (
                <a class="proto-card" href={protocolPageUrl(p)} target="_blank" rel="noopener">
                  <div class="card-top">
                    <span class="rank data">{i + 1}</span>
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="24" height="24" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <div class="card-name-wrap">
                      <span class="card-name">{p.name}</span>
                      <span class="kicker cat">{p.category}</span>
                    </div>
                  </div>
                  <div class="card-nums">
                    <span class="data card-tvl">{fmtTvl(p.tvl, dfLocale)}</span>
                    <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_1d)}</span>
                  </div>
                  {spark && (
                    <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                      <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                    </svg>
                  )}
                  {p.description && <p class="card-desc">{p.description}</p>}
                </a>
              );
            })}
          </div>
        </section>

        <p class="disclaimer kicker">{P.disclaimer}</p>
      </div>

      <aside class="side">
        {spotlight ? (
          <SpotlightTeaser
            project={spotlight.data.project}
            tagline={spotlight.data.tagline}
            href={`/spotlight/${spotlight.id}/`}
            guestColor={spotlight.data.guestColor}
          />
        ) : (
          <div class="house-block">
            <span class="kicker">{P.editorialLabel}</span>
            <p class="house-copy">{P.editorialCopy}</p>
            <a href={locale === 'en' ? '/en/defi/' : '/defi/'}>{P.editorialLink}</a>
          </div>
        )}

        {projectOfDay && (
          <div class="side-card">
            <span class="kicker">{P.projectOfDayLabel}</span>
            <div class="side-card-row">
              <span class="icon">
                {projectOfDay.logo && <img src={projectOfDay.logo} width="20" height="20" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
              </span>
              <span class="name">{projectOfDay.name}</span>
              <span class:list={['chg', 'data', (projectOfDay.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                {fmtChange(projectOfDay.change_1d)}
              </span>
            </div>
            <p class="side-card-note">{P.projectOfDayNote(fmtTvl(projectOfDay.tvl, dfLocale), projectOfDay.chains.length)}</p>
          </div>
        )}

        {newlyListed.length > 0 && (
          <div class="side-card">
            <span class="kicker">{P.newlyListedLabel}</span>
            <ul class="side-list">
              {newlyListed.map((p) => (
                <li>
                  <span class="name">{p.name}</span>
                  <span class="data tvl-mini">{fmtTvl(p.tvl, dfLocale)}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

