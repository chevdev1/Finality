    color: var(--graphite);
    cursor: pointer;
    border-left: 1px solid var(--rule);
  }
  .view-controls label:first-of-type {
    border-left: none;
  }
  .view-controls #view-table:checked ~ label[for='view-table'],
  .view-controls #view-cards:checked ~ label[for='view-cards'] {
    background: var(--ink);
    color: var(--ledger);
  }
  .cards {
    display: none;
  }
  /* .filter-bar is rendered by the FilterBar.astro child component, so it carries that
     component's own astro-cid attribute, not this page's — a plain selector here compiles
     with THIS page's scope attribute appended and silently matches nothing in the real DOM.
     :global() opts that one segment out of scoping so the selector can actually reach it —
     the same cross-component-scoping gotcha already hit once with FilterBar's own script. */
  .view-controls:has(#view-cards:checked) ~ .layout .protocol-table,
  .view-controls:has(#view-cards:checked) ~ .layout :global(.filter-bar) {
    display: none;
  }
  .view-controls:has(#view-cards:checked) ~ .layout .protocol-cards {
