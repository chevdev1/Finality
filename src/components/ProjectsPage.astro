  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Zero-JS view switch: two radios (visually hidden, native keyboard/focus behavior kept)
     drive everything else through :has() on a shared ancestor of the toggle and the content —
     the same "native control + CSS" approach as the mobile menu and every accordion on this
     page, just using a newer selector instead of the [open] attribute. */
  .view-controls {
    display: inline-flex;
    border: 1px solid var(--rule);
    margin-bottom: 24px;
  }
  .view-controls label {
    padding: 7px 16px;
    font-family: var(--font-data);
