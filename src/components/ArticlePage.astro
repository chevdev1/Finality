---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VerificationLog from '../components/VerificationLog.astro';
import RelatedList from '../components/RelatedList.astro';
import AuthorCard from '../components/AuthorCard.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import ArticleSeal from '../components/ArticleSeal.astro';
import ArticleImage from '../components/ArticleImage.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SECTION_LABELS, STATUS_LABELS } from '../lib/labels';
import { SECTION_LABELS_EN, STATUS_LABELS_EN, type Locale } from '../lib/i18n';
import { fetchThemedPhoto } from '../lib/pexels-client';

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'news'>>>[number];
  // English body/takeaways (src/content/news-en, same slug). Present only for locale 'en'.
  enEntry?: Awaited<ReturnType<typeof getCollection<'newsEn'>>>[number];
  locale?: Locale;
}

const { entry, enEntry, locale = 'ru' } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const L = en
  ? {
      crumbsAria: 'Breadcrumbs',
      takeaways: 'Key points',
      sources: 'Sources',
      published: 'Published',
      updated: 'Updated',
      photo: 'Photo',
      toc: 'On this page',
      related: 'Related stories',
    }
  : {
      crumbsAria: 'Хлебные крошки',
      takeaways: 'Главное',
      sources: 'Источники',
      published: 'Опубликовано',
      updated: 'Обновлено',
      photo: 'Фото',
      toc: 'На этой странице',
      related: 'Связанные материалы',
    };
const sectionLabels = en ? SECTION_LABELS_EN : SECTION_LABELS;
const statusLabels = en ? STATUS_LABELS_EN : STATUS_LABELS;
const title = en ? (entry.data.title_en ?? entry.data.title) : entry.data.title;
const dek = en ? (entry.data.dek_en ?? entry.data.dek) : entry.data.dek;
const takeaways = en && enEntry ? enEntry.data.takeaways : entry.data.takeaways;
const { Content, headings } = await render(en && enEntry ? enEntry : entry);
const author = await getEntry('authors', entry.data.author);
// Falls back to the hash-derived seal (ArticleSeal) whenever there's no imageQuery, no
// PEXELS_API_KEY configured, or the search comes back empty — every article still gets a
// picture either way, per the brief's carve-out for this feature (see README "Article imagery").
const photo = entry.data.imageQuery ? await fetchThemedPhoto(entry.data.imageQuery) : null;

const news = await getCollection('news');
const relatedEntries = entry.data.related
  .map((slug) => news.find((n) => n.id === slug))
  .filter((n): n is (typeof news)[number] => !!n)
  .slice(0, 3);

const related = relatedEntries.map((n) => ({
  title: en ? (n.data.title_en ?? n.data.title) : n.data.title,
  href: `${prefix}/${n.data.section}/${n.id}/`,
  section: n.data.section,
  checksCount: n.data.checks.length,
}));

function fmtDate(d: Date) {
  return d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
}

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const articleUrl = `${siteUrl}${prefix}/${entry.data.section}/${entry.id}/`;
const ogImageUrl = `${siteUrl}${en ? '/og/en' : '/og'}/${entry.data.section}/${entry.id}.png`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: title,
    description: dek,
    inLanguage: en ? 'en' : 'ru',
    image: photo ? [photo.src, ogImageUrl] : [ogImageUrl],
    articleSection: sectionLabels[entry.data.section],
    isAccessibleForFree: true,
    datePublished: entry.data.publishedAt.toISOString(),
    dateModified: entry.data.updatedAt.toISOString(),
    author: author
      ? { '@type': 'Person', name: author.data.name, url: `${siteUrl}${prefix}/author/${entry.data.author}/`, sameAs: author.data.sameAs }
      : undefined,
    publisher: { '@type': 'Organization', name: 'Finality', logo: `${siteUrl}/og-default.png` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Finality', item: `${siteUrl}${prefix}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: sectionLabels[entry.data.section],
        item: `${siteUrl}${prefix}/${entry.data.section}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: `${siteUrl}${prefix}/${entry.data.section}/${entry.id}/`,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={`${title} — Finality`}
  description={dek}
  jsonLd={jsonLd}
  ogImage={ogImageUrl}
  article={{
    publishedTime: entry.data.publishedAt.toISOString(),
    modifiedTime: entry.data.updatedAt.toISOString(),
    section: sectionLabels[entry.data.section],
    author: author?.data.name,
  }}
>
  <article class="wrap article-layout">
    <nav class="crumbs" aria-label={L.crumbsAria}>
      <a href={`${prefix}/`}>Finality</a> / <a href={`${prefix}/${entry.data.section}/`}>{sectionLabels[entry.data.section]}</a>
    </nav>

    <header class="art-header">
      <span class="status-word">{statusLabels[entry.data.status]}</span>
      <h1>{title}</h1>
      <p class="lead">{dek}</p>
      {author && (
        <a class="byline" href={`${prefix}/author/${entry.data.author}/`}>
          <span class="avatar" aria-hidden="true">{author.data.initials}</span>
          {author.data.name} · {en ? (author.data.role_en ?? author.data.role) : author.data.role}
        </a>
      )}
    </header>

    <div class="prose">
      {photo ? <ArticleImage photo={photo} creditLabel={L.photo} /> : <ArticleSeal seed={entry.id} />}
      <KeyTakeaways items={takeaways} label={L.takeaways} />
      <TableOfContents headings={headings} label={L.toc} />
      <Content />
      <div class="sources">
        <span class="kicker">{L.sources}</span>
        <ul>
          {entry.data.sources.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener">{en ? (s.title_en ?? s.title) : s.title}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <aside class="rail">
      <div class="dates">
        <div>
          <span class="kicker">{L.published}</span>
          <time datetime={entry.data.publishedAt.toISOString()} class="data">{fmtDate(entry.data.publishedAt)}</time>
        </div>
        <div>
          <span class="kicker">{L.updated}</span>
          <time datetime={entry.data.updatedAt.toISOString()} class="data">{fmtDate(entry.data.updatedAt)}</time>
        </div>
      </div>
      <VerificationLog checks={entry.data.checks} status={entry.data.status} locale={locale} />
      <RelatedList items={related} heading={L.related} locale={locale} />
      {author && (
        <AuthorCard
          name={author.data.name}
          role={en ? (author.data.role_en ?? author.data.role) : author.data.role}
          bio={en ? (author.data.bio_en ?? author.data.bio) : author.data.bio}
          initials={author.data.initials}
          slug={entry.data.author}
          locale={locale}
        />
      )}
    </aside>
  </article>
</BaseLayout>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 32px;
    padding-block: 24px 48px;
  }
  .crumbs {
    grid-column: 1 / -1;
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    text-decoration: none;
    color: var(--graphite);
  }
  .art-header {
    grid-column: 1;
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }
  /* Section is already named one line up in the breadcrumb, and the status word repeats
     again just below in the verification log's own summary — an eyebrow tag here used to
     show both a second time, three repeats of the same two words within one screen. Just
     the status survives here, since "still developing / confirmed" is genuinely useful
     context to read before the headline, right where the breadcrumb doesn't cover it. */
  .art-header .status-word {
    color: var(--graphite);
    font-size: 13px;
  }
  .art-header h1 {
    font-size: var(--step-h1);
    margin: 0;
  }
  .lead {
    max-width: 64ch;
    color: var(--graphite);
    font-size: var(--step-lead);
    margin: 0;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-size: 14px;
  }
  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ledger);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-data);
    font-size: 12px;
  }
  .prose {
    grid-column: 1;
    max-width: 64ch;
    font-size: var(--step-body);
    line-height: 1.6;
  }
  .prose > :global(.seal),
  .prose > :global(.figure),
  .prose > :global(.takeaways),
  .prose > :global(.toc) {
    margin-bottom: 24px;
  }
  .prose :global(h2) {
    font-size: var(--step-h3);
    margin-top: 2em;
  }
  .prose :global(p) {
    margin: 1em 0;
  }
  /* Glossary cross-links are the first <a> tags to ever appear inside article body markdown —
     without this, they'd fall back to the browser default (blue, underlined), clashing with
     the serif body copy. Styled like the site's other inline text links (e.g. detail-links on
     /projects/): underline in --rule, not a full blue link. */
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .prose :global(.data-inset) {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 16px;
    font-family: var(--font-data);
    font-size: 13px;
    color: var(--graphite);
    margin: 1.5em 0;
  }
  .sources {
    margin-top: 2em;
    border-top: 1px solid var(--rule);
    padding-top: 16px;
  }
  .sources ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  /* Dates, the verification log, related links and the author card used to be four separate
     grid items pinned to rows 2–4 in column 2, matching column 1's row structure (header,
     then the full article body). Column 1's body row is as tall as the article — so "dates"
     (spanning into that row) stretched into a box thousands of pixels tall with its two short
     lines pinned to the top, leaving a huge dead gap before the next sidebar item started at
     that row's boundary. One rail, spanning the same two rows as one item with its own
     align-content:start, stacks its children by their own height instead of the article's. */
  .rail {
    grid-column: 2;
    grid-row: 2 / span 2;
    display: grid;
    gap: 32px;
    align-content: start;
    /* Grid items default to min-width:auto — without this, a wide child (the verification
       log's summary row, unbroken related-article titles) forces the whole rail past its
       280px track instead of wrapping inside it, spilling text off the right edge. */
    min-width: 0;
  }
  .dates {
    display: grid;
    gap: 16px;
    font-size: 13px;
  }
  .dates > div {
    display: grid;
    gap: 2px;
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .rail {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
