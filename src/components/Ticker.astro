---
import { fetchQuotes, fmtUsd } from '../lib/coingecko-client';
import type { Locale } from '../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ru' } = Astro.props;
const updatedLabel = locale === 'en' ? 'Updated' : 'Обновлено';

// Build-time fetch so the static, no-JS fallback already shows real prices as of the
// last build, not placeholder numbers. The client script below re-fetches periodically
// once the page is interactive to keep them live during the visit.
const quotes = await fetchQuotes();

const rows = [
  { sym: 'BTC', id: 'bitcoin' as const, decimals: 0 },
  { sym: 'ETH', id: 'ethereum' as const, decimals: 0 },
  { sym: 'SOL', id: 'solana' as const, decimals: 1 },
  { sym: 'USDT', id: 'tether' as const, decimals: 4 },
].map((r) => {
  const q = quotes?.[r.id];
  return {
    ...r,
    px: q ? q.usd : null,
    chgPct: q ? q.usd_24h_change : null,
    up: q ? q.usd_24h_change >= 0 : true,
  };
});

function fmtPx(n: number | null, decimals: number) {
  if (n === null) return '—';
  return n.toLocaleString('ru-RU', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
}

function fmtUpdated(d: Date) {
  return d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';
}
const buildTime = fmtUpdated(new Date());
---

<div class="ticker" data-ticker>
  <span class="badge">COINGECKO</span>
  <div class="track" data-track>
    {rows.map((r) => (
      <span class="item" data-sym={r.id} data-decimals={r.decimals}>
        <span class="sym">{r.sym}</span>
        <span class="px data" data-px>{fmtPx(r.px, r.decimals)}</span>
        {r.chgPct !== null && (
          <span class:list={['chg', 'data', r.up ? 'up' : 'down']} data-chg>
            <span data-arrow>{r.up ? '▲' : '▼'}</span> <span data-pct>{Math.abs(r.chgPct).toFixed(1)}</span>%
          </span>
        )}
      </span>
    ))}
    <span class="item updated data" data-updated data-updated-label={updatedLabel}>{updatedLabel} {buildTime}</span>
  </div>
</div>

<script>
  import { fetchQuotes } from '../lib/coingecko-client';

  const ticker = document.querySelector<HTMLElement>('[data-ticker]');
  const track = ticker?.querySelector<HTMLElement>('[data-track]');
  if (ticker && track) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = document.hidden;

    ticker.addEventListener('mouseenter', () => (paused = true));
    ticker.addEventListener('mouseleave', () => (paused = false));
    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
    });

    // Only duplicate the item set (for a seamless loop) when it doesn't already fill the
    // ticker's width. Rendering two copies unconditionally used to make the last couple of
    // items (SOL, USDT) visibly repeat inside the viewport on wide screens where one copy
    // was already wide enough — the fix is to measure first, not to hide it with CSS.
    const singleWidth = track.scrollWidth;
    const fits = singleWidth <= ticker.clientWidth;
    if (!fits && !reduce) {
      track.append(...Array.from(track.children).map((el) => el.cloneNode(true) as HTMLElement));
    }

    if (!fits && !reduce) {
      let x = 0;
      let last = performance.now();
      const speed = 40; // px/s
      const half = singleWidth;

      function step(now: number) {
        const dt = (now - last) / 1000;
        last = now;
        if (!paused) {
          x -= speed * dt;
          if (Math.abs(x) >= half) x += half;
          track!.style.transform = `translateX(${x}px)`;
        }
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // Re-fetch real quotes periodically and flash whichever price actually moved
    // since the last poll — this is the brief's "price flash" motion spec (§5),
    // now driven by a real feed instead of a simulated one.
    const ids = ['bitcoin', 'ethereum', 'solana', 'tether'] as const;
    async function poll() {
      if (!paused) {
        const quotes = await fetchQuotes();
        if (quotes) {
          for (const id of ids) {
            const q = quotes[id];
            if (!q) continue;
            const els = ticker!.querySelectorAll<HTMLElement>(`[data-sym="${id}"]`);
            for (const el of els) {
              const decimals = Number(el.dataset.decimals);
              const px = el.querySelector<HTMLElement>('[data-px]');
              const chg = el.querySelector<HTMLElement>('[data-chg]');
              const arrow = el.querySelector<HTMLElement>('[data-arrow]');
              const pct = el.querySelector<HTMLElement>('[data-pct]');
              const nextText = q.usd.toLocaleString('ru-RU', {
                minimumFractionDigits: decimals,
                maximumFractionDigits: decimals,
              });
              const changed = px && px.textContent !== nextText;
              const up = q.usd_24h_change >= 0;
              if (px) px.textContent = nextText;
              if (chg) chg.className = `chg data ${up ? 'up' : 'down'}`;
              if (arrow) arrow.textContent = up ? '▲' : '▼';
              if (pct) pct.textContent = Math.abs(q.usd_24h_change).toFixed(1);
              if (changed) {
                px?.classList.add('flash');
                setTimeout(() => px?.classList.remove('flash'), 160);
              }
            }
          }
          const updated = new Date().toLocaleTimeString('ru-RU', {
            hour: '2-digit',
            minute: '2-digit',
            timeZone: 'UTC',
          }) + ' UTC';
          for (const el of ticker!.querySelectorAll<HTMLElement>('[data-updated]')) {
            const label = el.dataset.updatedLabel || 'Обновлено';
            el.textContent = `${label} ${updated}`;
          }
        }
      }
      setTimeout(poll, 60000);
    }
    setTimeout(poll, 60000);
  }
</script>

<style>
  .ticker {
    height: 34px;
    background: var(--ink);
    color: var(--ledger);
    overflow: hidden;
    display: flex;
    align-items: center;
    white-space: nowrap;
    position: relative;
  }
  .badge {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 9px;
    font-family: var(--font-data);
    letter-spacing: 0.05em;
    /* --graphite on --ink is 2.85:1 — well under WCAG AA. --graphite is tuned for the
       light --ledger/--paper backgrounds it's paired with everywhere else on the site;
       the ticker is the one place text sits on dark --ink, so it needs its own lighter
       tint (7.08:1) rather than reusing that token here. */
    color: #9aa39d;
    background: var(--ink);
    padding-left: 8px;
    z-index: 1;
  }
  /* In dark theme --ink flips to a light color (it's the page's text color there), so the
     ticker — always background:var(--ink) — flips from a dark bar to a light one. --graphite/
     --up/--down flip too, but the OTHER way (toward light tints, for text on the now-dark
     page) — the opposite of what a now-light ticker needs. So this isn't "swap to the
     token," it's "pin back to the fixed dark-on-light values the light theme's tokens
     happened to already be," spelled out explicitly rather than chasing a token that's
     moving in the wrong direction. */
  :root[data-theme='dark'] .badge {
    color: #56615b;
  }
  .track {
    display: inline-flex;
    will-change: transform;
  }
  .item {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 0 20px;
    font-size: 13px;
  }
  .sym {
    font-weight: 700;
  }
  .updated {
    color: #9aa39d;
    font-size: 11px;
  }
  /* --up/--down (#0B7A4E / #C8322B) are tuned for light backgrounds — on the ticker's dark
     --ink they'd fail contrast almost entirely. These are lighter tints of the same hue,
     confirmed at 10.0:1 / 7.6:1 on --ink. */
  .up {
    color: #6fd39a;
  }
  .down {
    color: #ef8a85;
  }
  :root[data-theme='dark'] .up {
    color: #0b7a4e;
  }
  :root[data-theme='dark'] .down {
    color: #c8322b;
  }
  :root[data-theme='dark'] .updated {
    color: #56615b;
  }
  /* Price flash: background-color only, per the brief's motion table (never keyframes). */
  .px {
    padding: 0 2px;
    background-color: transparent;
    transition: background-color 180ms ease;
  }
  .px.flash {
    background-color: rgba(242, 244, 240, 0.22);
    transition: background-color 160ms ease;
  }
  /* Flash lightens against the ticker's normally-dark bar; in dark theme that bar flips
     light (see the .badge/.up/.down overrides above), so the flash needs to darken instead. */
  :root[data-theme='dark'] .px.flash {
    background-color: rgba(21, 24, 26, 0.18);
  }
  @media (prefers-reduced-motion: reduce) {
    /* The brief keeps color flashes even under reduced motion — only stagger and
       positional shifts get removed. This overrides global.css's blanket
       transition-duration squash for this one element on purpose. */
    .px,
    .px.flash {
      transition-duration: 160ms !important;
    }
  }
</style>
