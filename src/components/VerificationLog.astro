---
import VerificationMeter from './VerificationMeter.astro';
import { STATUS_LABELS } from '../lib/labels';
import { STATUS_LABELS_EN, type Locale } from '../lib/i18n';

interface CheckDef {
  id: number;
  label: string;
}

interface Props {
  checks: { id: number; at: Date }[];
  status: 'developing' | 'final';
  open?: boolean;
  locale?: Locale;
}

const { checks, status, open = false, locale = 'ru' } = Astro.props;

const CHECK_DEFS_RU: CheckDef[] = [
  { id: 1, label: 'Первоисточник найден и проставлен ссылкой' },
  { id: 2, label: 'Ончейн-данные подтверждают утверждение' },
  { id: 3, label: 'Независимое второе издание сообщает то же самое' },
  { id: 4, label: 'Официальное заявление стороны получено' },
  { id: 5, label: 'Цифры сверены редакцией' },
  { id: 6, label: 'Подпись выпускающего редактора' },
];

const CHECK_DEFS_EN: CheckDef[] = [
  { id: 1, label: 'Primary source found and linked' },
  { id: 2, label: 'On-chain data confirms the claim' },
  { id: 3, label: 'An independent second outlet reports the same thing' },
  { id: 4, label: "The other party's official statement is on record" },
  { id: 5, label: 'Numbers checked by the editors' },
  { id: 6, label: 'Signed off by the editor on duty' },
];

const CHECK_DEFS = locale === 'en' ? CHECK_DEFS_EN : CHECK_DEFS_RU;
const statusLabel = locale === 'en' ? STATUS_LABELS_EN[status] : STATUS_LABELS[status];
const countLabel = locale === 'en' ? `${checks.length} of 6 checks passed` : `${checks.length} из 6 проверок пройдено`;
const openLabel = locale === 'en' ? 'OPEN' : 'ОТКРЫТО';

const byId = new Map(checks.map((c) => [c.id, c.at]));
const filled = checks.length;

function fmt(d: Date) {
  return d.toISOString().slice(5, 16).replace('T', ' ') + ' UTC';
}
---

<details class="log" open={open}>
  <summary>
    <VerificationMeter filled={filled} label={countLabel} />
    <span class="data status-count">{countLabel}</span>
    <span class="status-word">{statusLabel}</span>
  </summary>
  <div class="rows-wrapper">
    <div class="rows">
      {CHECK_DEFS.map((def) => {
        const at = byId.get(def.id);
        return (
          <div class="row">
            <span class="cell-mini" class:list={{ on: !!at }} aria-hidden="true"></span>
            <span class="check-label">{def.label}</span>
            <span class="data check-time">{at ? fmt(at) : openLabel}</span>
          </div>
        );
      })}
    </div>
  </div>
</details>

<style>
  .log {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 16px;
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    cursor: pointer;
    list-style: none;
    /* Flex items default to min-width:auto, so "проверок пройдено" + "РАЗВИВАЕТСЯ" refused
       to shrink and pushed the whole card past its column in a narrow sidebar — wrap + this
       lets long status text drop to its own line instead of overflowing the card's border. */
    min-width: 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .status-count {
    font-size: var(--step-meta);
    color: var(--graphite);
  }
  /* Native <details> open/close drives this purely in CSS: the [open] attribute
     selector below picks a longer transition for the reveal than the collapse
     (brief §5: exit always faster than entry), and min-height: 0 on .rows lets
     the fr-sized track actually shrink to zero instead of clamping to content size. */
  .rows-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 150ms var(--ease-standard), visibility 0s linear 150ms;
  }
  .log[open] .rows-wrapper {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 200ms var(--ease-standard), visibility 0s linear 0s;
  }
  .rows {
    min-height: 0;
    overflow: hidden;
    display: grid;
    gap: 10px;
    padding-top: 14px;
  }
  .row {
    display: grid;
    grid-template-columns: 16px 1fr auto;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  .cell-mini {
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--ink);
    background: transparent;
  }
  .cell-mini.on {
    background: var(--ink);
  }
  .check-time {
    color: var(--graphite);
    font-size: 11px;
    white-space: nowrap;
  }
</style>
