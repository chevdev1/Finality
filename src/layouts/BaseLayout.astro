---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import SearchIndex from '../components/SearchIndex.astro';
import { UI, altPath, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  canonicalPath?: string;
  locale?: Locale;
}

const { title, description, jsonLd = [], ogImage, canonicalPath, locale = 'ru' } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pathname = canonicalPath ?? Astro.url.pathname;
const canonical = `${siteUrl}${pathname}`;
const resolvedOgImage = ogImage ?? `${siteUrl}/og-default.png`;
const t = UI[locale];
const ruAlt = altPath(pathname, 'ru');
const enAlt = altPath(pathname, 'en');
const hasRealAlternate = locale === 'ru' ? enAlt.exact : ruAlt.exact;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Finality',
  url: siteUrl,
  logo: `${siteUrl}/og-default.png`,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Finality',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const allSchema = [orgSchema, websiteSchema, ...jsonLd];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {hasRealAlternate && (
      <>
        <link rel="alternate" hreflang="ru" href={`${siteUrl}${ruAlt.href}`} />
        <link rel="alternate" hreflang="en" href={`${siteUrl}${enAlt.href}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${ruAlt.href}`} />
      </>
    )}
    <script is:inline>
      // Runs before any CSS paints, so the page never flashes light then immediately
      // switches dark for a returning dark-mode reader. Kept out of ThemeToggle.astro
      // (which lives in <body>, rendered too late to prevent that flash) on purpose.
      (function () {
        try {
          var saved = localStorage.getItem('finality-theme');
          var theme =
            saved === 'dark' || saved === 'light'
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Finality" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />

    {allSchema.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Ticker locale={locale} />
    <Header locale={locale} altHref={locale === 'ru' ? enAlt.href : ruAlt.href} />
    <SearchIndex locale={locale} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <p>{t.footerText} <a href={locale === 'ru' ? '/about/' : '/en/about/'}>{t.footerAboutLink}</a>.</p>
        <p class="kicker">{t.copyright}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 48px;
    padding: 32px 0;
    color: var(--graphite);
    font-size: 13px;
  }
  .footer-inner {
    display: grid;
    gap: 8px;
  }
  .footer-inner a {
    color: var(--graphite);
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }
  .footer-inner a:hover {
    color: var(--ink);
  }
</style>
