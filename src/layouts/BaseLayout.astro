---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import SearchIndex from '../components/SearchIndex.astro';
import { UI, altPath, type Locale } from '../lib/i18n';
import { fitTitle, fitDescription } from '../lib/seo';
import { ClientRouter } from 'astro:transitions';
import { allTopicLinks } from '../lib/topics';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  canonicalPath?: string;
  locale?: Locale;
  noindex?: boolean;
  // Set for news articles: switches og:type to "article" and emits article:* meta.
  article?: { publishedTime: string; modifiedTime: string; section: string; author?: string };
}

const { title, description, jsonLd = [], ogImage, canonicalPath, locale = 'ru', noindex = false, article } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pathname = canonicalPath ?? Astro.url.pathname;
const canonical = `${siteUrl}${pathname}`;
const resolvedOgImage = ogImage ?? `${siteUrl}${locale === 'en' ? '/og-default-en.png' : '/og-default.png'}`;
const topicLinks = await allTopicLinks(locale);
const seoTitle = fitTitle(title);
const seoDescription = fitDescription(description);
const ogLocale = locale === 'en' ? 'en_US' : 'ru_RU';
const ogLocaleAlt = locale === 'en' ? 'ru_RU' : 'en_US';
const t = UI[locale];
const ruAlt = altPath(pathname, 'ru');
const enAlt = altPath(pathname, 'en');
const hasRealAlternate = locale === 'ru' ? enAlt.exact : ruAlt.exact;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Finality',
  url: siteUrl,
  logo: `${siteUrl}/og-default.png`,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Finality',
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const allSchema = [orgSchema, websiteSchema, ...jsonLd];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {hasRealAlternate && (
      <>
        <link rel="alternate" hreflang="ru" href={`${siteUrl}${ruAlt.href}`} />
        <link rel="alternate" hreflang="en" href={`${siteUrl}${enAlt.href}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${ruAlt.href}`} />
      </>
    )}
    <script is:inline>
      // Runs before any CSS paints, so the page never flashes light then immediately
      // switches dark for a returning dark-mode reader. Kept out of ThemeToggle.astro
      // (which lives in <body>, rendered too late to prevent that flash) on purpose.
      (function () {
        try {
          var saved = localStorage.getItem('finality-theme');
          var theme =
            saved === 'dark' || saved === 'light'
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <title>{seoTitle}</title>
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <meta name="description" content={seoDescription} />
    {import.meta.env.PUBLIC_GSC_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />}
    {import.meta.env.PUBLIC_BING_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Finality"
      href={locale === 'en' ? `${siteUrl}/en/rss.xml` : `${siteUrl}/rss.xml`}
    />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Finality" />
    <meta property="og:locale" content={ogLocale} />
    {hasRealAlternate && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title.replace(/ — Finality$/, '')} />
    <meta property="og:description" content={seoDescription} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:modified_time" content={article.modifiedTime} />}
    {article && <meta property="article:section" content={article.section} />}
    {article?.author && <meta property="article:author" content={article.author} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title.replace(/ — Finality$/, '')} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {allSchema.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    <Ticker locale={locale} />
    <Header locale={locale} altHref={locale === 'ru' ? enAlt.href : ruAlt.href} />
    <SearchIndex locale={locale} />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <nav class="footer-nav" aria-label={t.sectionsHeading}>
          <a href={locale === 'ru' ? '/projects/' : '/en/projects/'}>{t.projects}</a>
          <a href={locale === 'ru' ? '/calendar/' : '/en/calendar/'}>{t.calendar}</a>
          <a href={locale === 'ru' ? '/regulation/' : '/en/regulation/'}>{t.tracker}</a>
          <a href={locale === 'ru' ? '/glossary/' : '/en/glossary/'}>{t.glossary}</a>
          {topicLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <p>{t.footerText} <a href={locale === 'ru' ? '/about/' : '/en/about/'}>{t.footerAboutLink}</a>.</p>
        <p class="kicker">{t.copyright}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 48px;
    padding: 32px 0;
    color: var(--graphite);
    font-size: 13px;
  }
  .footer-inner {
    display: grid;
    gap: 8px;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 4px;
  }
  .footer-nav a {
    font-family: var(--font-data);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .footer-inner a {
    color: var(--graphite);
    text-decoration-color: var(--rule);
    text-underline-offset: 2px;
  }
  .footer-inner a:hover {
    color: var(--ink);
  }
</style>
