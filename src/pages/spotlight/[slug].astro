---
import { getCollection } from 'astro:content';
import SpotlightDetailPage from '../../components/SpotlightDetailPage.astro';

export async function getStaticPaths() {
  const items = await getCollection('spotlight');
  // project-template.md is a filled-in example for whoever writes the next Spotlight, not
  // something to publish — without this filter its "[Project]"/"[Chain]"/etc. placeholder
  // fields would build a real, public page at /spotlight/project-template/.
  return items
    .filter((entry) => !entry.data.project.includes('['))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<SpotlightDetailPage entry={entry} locale="ru" />
