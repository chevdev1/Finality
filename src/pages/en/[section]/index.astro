---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import Pagination from '../../../components/Pagination.astro';
import VideoWidget from '../../../components/VideoWidget.astro';
import { SECTIONS } from '../../../content.config';
import { SECTION_LABELS_EN, SECTION_INTROS_EN, UI } from '../../../lib/i18n';
import { paginate } from '../../../lib/pagination';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: string };
const t = UI.en;
const news = (await getCollection('news'))
  .filter((n) => n.data.section === section)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const { pageItems, totalPages } = paginate(news, 1);
const sectionLabel = SECTION_LABELS_EN[section] ?? section;

const sectionVideo = (await getCollection('videos'))
  .filter((v) => v.data.section === section)
  .sort((a, b) => b.data.addedAt.valueOf() - a.data.addedAt.valueOf())
  .slice(0, 1)
  .map((v) => ({ title: v.data.title, youtubeId: v.data.youtubeId, channel: v.data.channel, note: v.data.note }));
---

<BaseLayout
  locale="en"
  title={`${sectionLabel} — Finality`}
  description={SECTION_INTROS_EN[section]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${sectionLabel} — Finality`,
      about: sectionLabel,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: news.map((n, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `/${n.data.section}/${n.id}/`,
      })),
    },
  ]}
>
  <div class="wrap hub">
    <nav class="crumbs"><a href="/en/">Finality</a> / {sectionLabel}</nav>
    <h1 class="section-title">{sectionLabel}</h1>
    <p class="intro">{SECTION_INTROS_EN[section]}</p>
    <p class="notice">{t.notTranslatedNotice}</p>
    {sectionVideo.length > 0 && (
      <div class="section-video">
        <VideoWidget items={sectionVideo} heading="Related video" />
      </div>
    )}
    <div class="feed">
      {pageItems.map((n) => (
        <ArticleRow
          title={n.data.title}
          dek={n.data.dek}
          href={`/${n.data.section}/${n.id}/`}
          section={sectionLabel}
          publishedAt={n.data.publishedAt}
          checksCount={n.data.checks.length}
          slug={n.id}
          imageQuery={n.data.imageQuery}
        />
      ))}
    </div>
    <Pagination basePath={`/en/${section}`} page={1} totalPages={totalPages} locale="en" />
  </div>
</BaseLayout>

<style>
  .hub {
    padding-block: 24px 48px;
    max-width: 860px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    color: var(--graphite);
    text-decoration: none;
  }
  .section-title {
    font-size: var(--step-h1);
    margin-top: 8px;
  }
  .intro {
    max-width: 68ch;
    color: var(--graphite);
    margin: 16px 0 16px;
  }
  .notice {
    margin: 0 0 24px;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--graphite);
    font-size: 13px;
    max-width: 68ch;
  }
  .section-video {
    max-width: 360px;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--rule);
  }
</style>
