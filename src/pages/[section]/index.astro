---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import Pagination from '../../components/Pagination.astro';
import { SECTIONS } from '../../content.config';
import { SECTION_LABELS } from '../../lib/labels';
import { SECTION_INTROS } from '../../lib/section-intros';
import { paginate } from '../../lib/pagination';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: string };
const news = (await getCollection('news'))
  .filter((n) => n.data.section === section)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const { pageItems, totalPages } = paginate(news, 1);
const sectionLabel = SECTION_LABELS[section] ?? section;
---

<BaseLayout
  title={`${sectionLabel} — Finality`}
  description={SECTION_INTROS[section]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${sectionLabel} — Finality`,
      about: sectionLabel,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: news.map((n, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `/${n.data.section}/${n.id}/`,
      })),
    },
  ]}
>
  <div class="wrap hub">
    <nav class="crumbs"><a href="/">Finality</a> / {sectionLabel}</nav>
    <h1 class="section-title">{sectionLabel}</h1>
    <p class="intro">{SECTION_INTROS[section]}</p>
    <div class="feed">
      {pageItems.map((n) => (
        <ArticleRow
          title={n.data.title}
          dek={n.data.dek}
          href={`/${n.data.section}/${n.id}/`}
          section={sectionLabel}
          publishedAt={n.data.publishedAt}
          checksCount={n.data.checks.length}
        />
      ))}
    </div>
    <Pagination basePath={`/${section}`} page={1} totalPages={totalPages} />
  </div>
</BaseLayout>

<style>
  .hub {
    padding-block: 24px 48px;
    max-width: 860px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    color: var(--graphite);
    text-decoration: none;
  }
  .section-title {
    font-size: var(--step-h1);
    margin-top: 8px;
  }
  .intro {
    max-width: 68ch;
    color: var(--graphite);
    margin: 16px 0 24px;
  }
</style>
