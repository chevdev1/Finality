---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { SECTIONS } from '../../content.config';
import { SECTION_LABELS } from '../../lib/labels';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params as { section: string };
const news = (await getCollection('news'))
  .filter((n) => n.data.section === section)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const intros: Record<string, string> = {
  bitcoin:
    'Раздел о биткоине следит за потоками в ETF, экономикой майнинга и решениями базового уровня, которые задевают все остальные разделы сайта. Мы отдаём предпочтение ончейн-данным перед заголовочными движениями цены и помечаем каждую цифру нашим счётчиком из шести проверок, чтобы было видно, насколько она подтверждена, прежде чем действовать.',
  ethereum:
    'Ethereum и его роллапы развиваются быстро, и большая часть сбоев — простой секвенсора, риск мостов, скачки газа — происходит на уровне L2, а не в базовой сети. Хаб следит за обоими уровнями с упором на то, что реально меняется для кошелька со средствами на роллапе.',
  defi:
    'Раздел DeFi делает акцент на риске оракулов и устройстве обеспечения — именно там сосредоточилась большая часть потерь этого года. Мы даём ссылку на ончейн-транзакцию для каждого инцидента, а не только на пост-мортем самого протокола.',
  stablecoins:
    'Раздел о стейблкоинах и платежах следит за ростом предложения, новыми рельсами расчётов и регуляторной границей между стейблкоином и ценной бумагой. Мы разделяем стейблкоин для трейдинга и стейблкоин для реальных платежей — это два очень разных рынка.',
  policy:
    'Раздел о регулировании следит за законопроектами, актами регуляторов и правоприменением, которые решают, что крипто-компаниям на крупных рынках можно делать дальше. Мы отслеживаем расклад голосов и процедурные детали не менее внимательно, чем итоговый результат.',
  rwa:
    'Раздел о токенизации реальных активов следит за токенизированными облигациями, акциями и кредитом — там, где объём действительно есть, а не там, где о нём заявляет пресс-релиз. Мы разделяем торговый объём и активы под управлением там, где источник это позволяет.',
  ai:
    'Раздел AI × крипта следит за автономными агентами, торгующими ончейн, API с оплатой по запросу и инфраструктурой, которая позволяет модели держать и тратить средства. Здесь уместен скепсис: категория привлекает больше маркетинга, чем подтверждённого объёма.',
  fintech:
    'Раздел финтеха следит за скучной, но важной инфраструктурой — рельсами расчётов, интеграциями необанков и зарплатными проектами — где крипта незаметно заменяет медленное звено корреспондентского банкинга, а конечный пользователь токена вообще не видит.',
  security:
    'Раздел безопасности следит за эксплойтами, реагированием на инциденты и сдвигом в сторону компрометации ключей как главной причины потерь. Каждый отчёт об инциденте здесь ссылается на ончейн-движение средств, а не просто на анонс.',
};

const sectionLabel = SECTION_LABELS[section] ?? section;
---

<BaseLayout
  title={`${sectionLabel} — Finality`}
  description={intros[section]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${sectionLabel} — Finality`,
      about: sectionLabel,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: news.map((n, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `/${n.data.section}/${n.id}/`,
      })),
    },
  ]}
>
  <div class="wrap hub">
    <nav class="crumbs"><a href="/">Finality</a> / {sectionLabel}</nav>
    <h1 class="section-title">{sectionLabel}</h1>
    <p class="intro">{intros[section]}</p>
    <div class="feed">
      {news.map((n) => (
        <ArticleRow
          title={n.data.title}
          dek={n.data.dek}
          href={`/${n.data.section}/${n.id}/`}
          section={sectionLabel}
          publishedAt={n.data.publishedAt}
          checksCount={n.data.checks.length}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hub {
    padding-block: 24px 48px;
    max-width: 860px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    color: var(--graphite);
    text-decoration: none;
  }
  .section-title {
    font-size: var(--step-h1);
    margin-top: 8px;
  }
  .intro {
    max-width: 68ch;
    color: var(--graphite);
    margin: 16px 0 24px;
  }
</style>
