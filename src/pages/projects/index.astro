---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpotlightTeaser from '../../components/SpotlightTeaser.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
  fetchTopChains,
  fetchTopProtocols,
  fetchTopGainers,
  fetchTvlHistory,
  sparklinePath,
  chainIconUrl,
  chainPageUrl,
  fmtTvl,
  fmtChange,
  fmtDate,
  type ProtocolTvl,
} from '../../lib/defillama-client';

const [chains, protocols, gainers] = await Promise.all([
  fetchTopChains(10),
  fetchTopProtocols(15),
  fetchTopGainers(10),
]);

// One history fetch per unique protocol slug, not per row — the same protocol often shows up
// in both the TVL table and the gainers table, and /protocol/{slug} is a much heavier request
// than the two list endpoints above (it returns years of history to get 30 days out of it).
const slugsNeedingHistory = [...new Set([...protocols, ...gainers].map((p) => p.slug).filter((s): s is string => !!s))];
const historyBySlug = new Map(
  await Promise.all(
    slugsNeedingHistory.map(async (slug) => [slug, await fetchTvlHistory(slug, 30)] as const)
  )
);
function sparkFor(slug: string | null) {
  if (!slug) return null;
  return sparklinePath(historyBySlug.get(slug) ?? []);
}

const totalTvl = chains.reduce((sum, c) => sum + c.tvl, 0);
const spotlights = await getCollection('spotlight');
// project-template.md ships in the repo as a filled-in example for whoever writes the next
// Spotlight, not something to publish — any bracketed field means it's still a template, and
// showing it to a reader looks like a live, sold placement that doesn't exist.
const spotlight = spotlights.find((s) => !s.data.project.includes('['));

const buildTime = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';

// "Project of the day" — the single biggest 24h TVL gainer already computed for the third
// table, reused rather than invented as a separate metric.
const projectOfDay = gainers[0];

// "Новые в рейтинге" — protocols DeFiLlama itself has dated as newest additions to its
// tracked list. Real field (listedAt), not a fabricated "trending" claim.
const newlyListed = [...protocols, ...gainers]
  .filter((p, i, arr) => arr.findIndex((x) => x.name === p.name) === i && p.listedAt)
  .sort((a, b) => (b.listedAt ?? 0) - (a.listedAt ?? 0))
  .slice(0, 4);

function protocolPageUrl(p: ProtocolTvl) {
  return p.slug ? `https://defillama.com/protocol/${p.slug}` : 'https://defillama.com';
}

// Categories come straight from DeFiLlama's own `category` field — real values already in
// the data (Lending, CEX, Liquid Staking...), not an invented taxonomy. Computed per table
// so the chip list never offers a category with zero matching rows in that specific table.
const protocolCategories = [...new Set(protocols.map((p) => p.category))].sort();
const gainerCategories = [...new Set(gainers.map((p) => p.category))].sort();
---

<BaseLayout
  title="Проекты — Finality"
  description="Рейтинг блокчейнов и протоколов по объёму заблокированных средств (TVL), с источником у каждой цифры."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Проекты — Finality',
      about: 'Рейтинг блокчейнов и протоколов по TVL',
    },
  ]}
>
  <div class="wrap page">
    <nav class="crumbs"><a href="/">Finality</a> / Проекты</nav>
    <h1 class="title">Проекты</h1>
    <p class="intro">
      Блокчейны и протоколы, отсортированные по объёму заблокированных средств (TVL). Разница в TVL
      за 24 часа — не то же самое, что рост числа пользователей, но это единственная метрика здесь,
      у которой есть открытый, проверяемый источник у каждой строки. Строки протоколов
      раскрываются — внутри описание, разбивка TVL по сетям и заметные события проекта.
    </p>

    <div class="stats">
      <div class="stat">
        <span class="kicker">
          Суммарный TVL, топ-10 сетей
          <span class="hint" tabindex="0">
            <span aria-hidden="true">?</span>
            <span class="hint-body" role="tooltip">Сумма TVL по методологии DeFiLlama: залоги, депозиты и застейканные активы во всех отслеживаемых протоколах каждой сети. Не рыночная капитализация.</span>
          </span>
        </span>
        <span class="data value">{fmtTvl(totalTvl)}</span>
      </div>
      <div class="stat">
        <span class="kicker">Протоколов в рейтинге</span>
        <span class="data value">{protocols.length}</span>
      </div>
      <div class="stat">
        <span class="kicker">Обновлено</span>
        <span class="data value updated-value">{buildTime}</span>
      </div>
      <div class="stat">
        <span class="kicker">Источник</span>
        <span class="value"><a href="https://defillama.com" target="_blank" rel="noopener">DeFiLlama ↗</a></span>
      </div>
    </div>

    <div class="layout">
      <div class="main">
        <section class="block">
          <div class="block-head">
            <h2>Топ блокчейнов по TVL</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Строка ведёт на страницу сети в DeFiLlama.</p>
          {chains.length === 0 && (
            <p class="empty-state">DeFiLlama не ответила при сборке страницы. Данные обновятся при следующей публикации.</p>
          )}
          <div class="table">
            {chains.map((c, i) => (
              <a class="row chain-row" href={chainPageUrl(c.name)} target="_blank" rel="noopener">
                <span class="rank data">{i + 1}</span>
                <span class="proto">
                  <span class="icon">
                    <img src={chainIconUrl(c.name)} width="16" height="16" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />
                  </span>
                  <span class="name">{c.name}</span>
                </span>
                <span class="tvl data">{fmtTvl(c.tvl)}</span>
                <span class="external" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>Топ протоколов по TVL</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Клик по строке разворачивает карточку проекта.</p>
          {protocols.length === 0 && (
            <p class="empty-state">DeFiLlama не ответила при сборке страницы. Данные обновятся при следующей публикации.</p>
          )}
          {protocols.length > 0 && <FilterBar categories={protocolCategories} />}
          <div class="table">
            {protocols.map((p, i) => (
              <details class="row proto-row" name="protocols-table" data-row data-name={p.name} data-category={p.category}>
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="18" height="18" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? 'сеть' : 'сетей'}</span>
                  <span class="tvl data">{fmtTvl(p.tvl)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class:list={['chg', 'week', 'data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_7d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">⌄</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}

                    <div class="detail-grid">
                      <div><span class="kicker">Категория</span><span>{p.category}</span></div>
                      <div><span class="kicker">Δ7 дней</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">Аудиты</span><span>{p.audits === '0' ? 'не найдены' : p.audits}</span></div>
                      {fmtDate(p.listedAt) && <div><span class="kicker">В реестре с</span><span class="data">{fmtDate(p.listedAt)}</span></div>}
                    </div>

                    {(() => {
                      const spark = sparkFor(p.slug);
                      return (
                        spark && (
                          <div class="sparkline-row">
                            <span class="kicker">TVL, 30 дней</span>
                            <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                              <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                            </svg>
                          </div>
                        )
                      );
                    })()}

                    {p.chainBreakdown.length > 0 && (
                      <div class="chain-breakdown">
                        <span class="kicker">TVL по сетям</span>
                        {p.chainBreakdown.map((cb) => (
                          <div class="bar-row">
                            <span class="bar-label">{cb.chain}</span>
                            <div class="bar-track">
                              <div class="bar-fill" style={`width:${Math.max(4, (cb.tvl / p.chainBreakdown[0].tvl) * 100)}%`} />
                            </div>
                            <span class="data bar-value">{fmtTvl(cb.tvl)}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {p.hallmarks.length > 0 && (
                      <div class="hallmarks">
                        <span class="kicker">Заметные события</span>
                        <ul>
                          {p.hallmarks.slice(0, 4).map((h) => (
                            <li><span class="data hallmark-date">{fmtDate(h.at)}</span><span>{h.label}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">Сайт проекта ↗</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">X (Twitter) ↗</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">Отчёт аудита ↗</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">Полная карточка на DeFiLlama ↗</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>Актуальные проекты — лидеры роста TVL за 24ч</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Только протоколы с TVL от $5 млн — иначе рост в процентах ничего не значит.</p>
          {gainers.length === 0 && (
            <p class="empty-state">DeFiLlama не ответила при сборке страницы. Данные обновятся при следующей публикации.</p>
          )}
          {gainers.length > 0 && <FilterBar categories={gainerCategories} placeholder="Найти проект…" />}
          <div class="table">
            {gainers.map((p, i) => (
              <details class="row proto-row" name="gainers-table" data-row data-name={p.name} data-category={p.category}>
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    <span class="icon">
                      {p.logo && <img src={p.logo} width="18" height="18" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
                    </span>
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? 'сеть' : 'сетей'}</span>
                  <span class="tvl data">{fmtTvl(p.tvl)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class:list={['chg', 'week', 'data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_7d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">⌄</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}

                    <div class="detail-grid">
                      <div><span class="kicker">Категория</span><span>{p.category}</span></div>
                      <div><span class="kicker">Δ7 дней</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">Аудиты</span><span>{p.audits === '0' ? 'не найдены' : p.audits}</span></div>
                      {fmtDate(p.listedAt) && <div><span class="kicker">В реестре с</span><span class="data">{fmtDate(p.listedAt)}</span></div>}
                    </div>

                    {(() => {
                      const spark = sparkFor(p.slug);
                      return (
                        spark && (
                          <div class="sparkline-row">
                            <span class="kicker">TVL, 30 дней</span>
                            <svg viewBox="0 0 64 20" class="sparkline" preserveAspectRatio="none" aria-hidden="true">
                              <polyline points={spark.points} class:list={['spark-line', spark.up ? 'up' : 'down']} />
                            </svg>
                          </div>
                        )
                      );
                    })()}

                    {p.chainBreakdown.length > 0 && (
                      <div class="chain-breakdown">
                        <span class="kicker">TVL по сетям</span>
                        {p.chainBreakdown.map((cb) => (
                          <div class="bar-row">
                            <span class="bar-label">{cb.chain}</span>
                            <div class="bar-track">
                              <div class="bar-fill" style={`width:${Math.max(4, (cb.tvl / p.chainBreakdown[0].tvl) * 100)}%`} />
                            </div>
                            <span class="data bar-value">{fmtTvl(cb.tvl)}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {p.hallmarks.length > 0 && (
                      <div class="hallmarks">
                        <span class="kicker">Заметные события</span>
                        <ul>
                          {p.hallmarks.slice(0, 4).map((h) => (
                            <li><span class="data hallmark-date">{fmtDate(h.at)}</span><span>{h.label}</span></li>
                          ))}
                        </ul>
                      </div>
                    )}

                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">Сайт проекта ↗</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">X (Twitter) ↗</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">Отчёт аудита ↗</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">Полная карточка на DeFiLlama ↗</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>

        <p class="disclaimer kicker">
          Данные получены при последней сборке страницы. Не инвестиционная рекомендация.
        </p>
      </div>

      <aside class="side">
        {spotlight ? (
          <SpotlightTeaser
            project={spotlight.data.project}
            tagline={spotlight.data.tagline}
            href={`/spotlight/${spotlight.id}/`}
            guestColor={spotlight.data.guestColor}
          />
        ) : (
          <div class="house-block">
            <span class="kicker">Материал редакции</span>
            <p class="house-copy">Разбор без спонсора: как читать TVL, аудиты и дату листинга,
              прежде чем доверять протоколу деньги.</p>
            <a href="/defi/">Читать раздел «DeFi» ↗</a>
          </div>
        )}

        {projectOfDay && (
          <div class="side-card">
            <span class="kicker">Проект дня — лидер роста TVL за 24ч</span>
            <div class="side-card-row">
              <span class="icon">
                {projectOfDay.logo && <img src={projectOfDay.logo} width="20" height="20" alt="" aria-hidden="true" loading="lazy" onerror="this.parentElement.style.visibility='hidden'" />}
              </span>
              <span class="name">{projectOfDay.name}</span>
              <span class:list={['chg', 'data', (projectOfDay.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                {fmtChange(projectOfDay.change_1d)}
              </span>
            </div>
            <p class="side-card-note">TVL {fmtTvl(projectOfDay.tvl)} на {projectOfDay.chains.length} {projectOfDay.chains.length === 1 ? 'сети' : 'сетях'} — самый быстрый рост за последние 24 часа среди протоколов с TVL от $5 млн.</p>
          </div>
        )}

        {newlyListed.length > 0 && (
          <div class="side-card">
            <span class="kicker">Новые в реестре DeFiLlama</span>
            <ul class="side-list">
              {newlyListed.map((p) => (
                <li>
                  <span class="name">{p.name}</span>
                  <span class="data tvl-mini">{fmtTvl(p.tvl)}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 24px 48px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    color: var(--graphite);
    text-decoration: none;
  }
  .title {
    font-size: var(--step-h1);
    margin-top: 8px;
  }
  .intro {
    max-width: 68ch;
    color: var(--graphite);
    margin: 16px 0 24px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 14px 0;
    margin-bottom: 32px;
  }
  .stat {
    display: grid;
    gap: 6px;
  }
  .stat .kicker {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .value {
    font-size: 22px;
    font-weight: 700;
  }
  .updated-value {
    font-weight: 400;
  }
  .value a {
    color: var(--ink);
  }
  .hint {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 13px;
    height: 13px;
    border: 1px solid var(--rule);
    color: var(--graphite);
    font-size: 9px;
    cursor: default;
  }
  .hint-body {
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    width: 240px;
    background: var(--ink);
    color: var(--ledger);
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: normal;
    font-size: 12px;
    line-height: 1.4;
    padding: 10px 12px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 150ms ease, visibility 0s linear 150ms;
    z-index: 5;
  }
  .hint:hover .hint-body,
  .hint:focus-visible .hint-body {
    opacity: 1;
    visibility: visible;
    transition: opacity 150ms ease 300ms, visibility 0s linear 300ms;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
  }
  .block {
    margin-bottom: 32px;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .block-head h2 {
    font-size: var(--step-h3);
  }
  .table-note {
    color: var(--graphite);
    margin: 0 0 8px;
  }
  .table {
    border-top: 1px solid var(--rule);
  }

  /* Shared row shell: both the plain <a> chain rows and the <details> protocol rows use the
     same grid so the three tables read as one visual system. Selectors are element+class
     (a.row / details.row) throughout so the later, more specific per-table overrides always
     win — mixing bare-class and element+class selectors is what silently broke the chain
     row's 4th column before. */
  a.row,
  details.row > summary {
    display: grid;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    grid-template-columns: 32px 1fr auto;
  }
  a.row.chain-row {
    grid-template-columns: 32px 1fr auto 20px;
  }
  details.proto-row > summary {
    grid-template-columns: 32px 1fr 80px 90px 64px 64px 20px;
  }
  details.row > summary::-webkit-details-marker {
    display: none;
  }
  .table > .row {
    border-bottom: 1px solid var(--rule);
  }
  @media (hover: hover) and (pointer: fine) {
    a.row:hover,
    details.row > summary:hover {
      background: var(--paper);
    }
  }
  .rank {
    color: var(--graphite);
    font-size: 12px;
  }
  .proto {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    overflow: hidden;
  }
  /* Every logo — chain or protocol — sits in the same fixed, bordered square regardless of
     the source asset's own shape (circle, square, rounded square, transparent PNG...). Brief
     §2.4 bans border-radius everywhere except author avatars, so the frame is a hard square;
     object-fit: contain keeps non-square source art from being cropped. This is what actually
     fixes the "странные формы" — we impose one shape system instead of showing whatever
     arbitrary shape each source icon happens to be. */
  .icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .name {
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cat {
    flex-shrink: 0;
  }
  .chains {
    color: var(--graphite);
    font-size: 12px;
    white-space: nowrap;
  }
  .tvl {
    text-align: right;
    white-space: nowrap;
  }
  .chg {
    text-align: right;
    white-space: nowrap;
  }
  .chg.week {
    opacity: 0.75;
    font-size: 13px;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }
  .external,
  .disclosure {
    color: var(--graphite);
    font-size: 14px;
    text-align: center;
  }
  .disclosure {
    transition: transform 160ms var(--ease-standard);
  }
