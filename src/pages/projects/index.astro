---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpotlightTeaser from '../../components/SpotlightTeaser.astro';
import {
  fetchTopChains,
  fetchTopProtocols,
  fetchTopGainers,
  chainIconUrl,
  chainPageUrl,
  fmtTvl,
  fmtChange,
  fmtListedDate,
  type ProtocolTvl,
} from '../../lib/defillama-client';

const [chains, protocols, gainers] = await Promise.all([
  fetchTopChains(10),
  fetchTopProtocols(15),
  fetchTopGainers(10),
]);

const totalTvl = chains.reduce((sum, c) => sum + c.tvl, 0);
const spotlights = await getCollection('spotlight');
const spotlight = spotlights[0];

function protocolPageUrl(p: ProtocolTvl) {
  return p.slug ? `https://defillama.com/protocol/${p.slug}` : 'https://defillama.com';
}
---

<BaseLayout
  title="Проекты — Finality"
  description="Рейтинг блокчейнов и протоколов по объёму заблокированных средств (TVL), с источником у каждой цифры."
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Проекты — Finality',
      about: 'Рейтинг блокчейнов и протоколов по TVL',
    },
  ]}
>
  <div class="wrap page">
    <nav class="crumbs"><a href="/">Finality</a> / Проекты</nav>
    <h1 class="title">Проекты</h1>
    <p class="intro">
      Блокчейны и протоколы, отсортированные по объёму заблокированных средств (TVL). Разница в TVL
      за 24 часа — не то же самое, что рост числа пользователей, но это единственная метрика здесь,
      у которой есть открытый, проверяемый источник у каждой строки. Строки протоколов
      раскрываются — внутри описание, категория, сети и ссылка на официальный сайт.
    </p>

    <div class="stats">
      <div class="stat">
        <span class="kicker">Суммарный TVL, топ-10 сетей</span>
        <span class="data value">{fmtTvl(totalTvl)}</span>
      </div>
      <div class="stat">
        <span class="kicker">Протоколов в рейтинге</span>
        <span class="data value">{protocols.length}</span>
      </div>
      <div class="stat">
        <span class="kicker">Источник</span>
        <span class="value"><a href="https://defillama.com" target="_blank" rel="noopener">DeFiLlama</a></span>
      </div>
    </div>

    <div class="layout">
      <div class="main">
        <section class="block">
          <div class="block-head">
            <h2>Топ блокчейнов по TVL</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Строка ведёт на страницу сети в DeFiLlama.</p>
          <div class="table">
            {chains.map((c, i) => (
              <a class="row chain-row" href={chainPageUrl(c.name)} target="_blank" rel="noopener">
                <span class="rank data">{i + 1}</span>
                <span class="proto">
                  <img src={chainIconUrl(c.name)} width="20" height="20" alt="" aria-hidden="true" loading="lazy" onerror="this.style.display='none'" />
                  <span class="name">{c.name}</span>
                </span>
                <span class="tvl data">{fmtTvl(c.tvl)}</span>
                <span class="external" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>Топ протоколов по TVL</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Клик по строке разворачивает карточку проекта.</p>
          <div class="table">
            {protocols.map((p, i) => (
              <details class="row proto-row">
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    {p.logo && <img src={p.logo} width="20" height="20" alt="" aria-hidden="true" loading="lazy" onerror="this.style.display='none'" />}
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? 'сеть' : 'сетей'}</span>
                  <span class="tvl data">{fmtTvl(p.tvl)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">＋</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}
                    <div class="detail-grid">
                      <div><span class="kicker">Категория</span><span>{p.category}</span></div>
                      <div><span class="kicker">Δ7 дней</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">Аудиты</span><span>{p.audits === '0' ? 'не найдены' : p.audits}</span></div>
                      {fmtListedDate(p.listedAt) && <div><span class="kicker">В реестре DeFiLlama с</span><span class="data">{fmtListedDate(p.listedAt)}</span></div>}
                      <div class="chains-list"><span class="kicker">Сети ({p.chains.length})</span><span>{p.chains.join(', ')}</span></div>
                    </div>
                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">Сайт проекта ↗</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">X (Twitter) ↗</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">Отчёт аудита ↗</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">Полная карточка на DeFiLlama ↗</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>

        <section class="block">
          <div class="block-head">
            <h2>Актуальные проекты — лидеры роста TVL за 24ч</h2>
            <span class="kicker">DeFiLlama</span>
          </div>
          <p class="table-note kicker">Только протоколы с TVL от $5 млн — иначе рост в процентах ничего не значит.</p>
          <div class="table">
            {gainers.map((p, i) => (
              <details class="row proto-row">
                <summary>
                  <span class="rank data">{i + 1}</span>
                  <span class="proto">
                    {p.logo && <img src={p.logo} width="20" height="20" alt="" aria-hidden="true" loading="lazy" onerror="this.style.display='none'" />}
                    <span class="name">{p.name}</span>
                    <span class="kicker cat">{p.category}</span>
                  </span>
                  <span class="chains data">{p.chains.length} {p.chains.length === 1 ? 'сеть' : 'сетей'}</span>
                  <span class="tvl data">{fmtTvl(p.tvl)}</span>
                  <span class:list={['chg', 'data', (p.change_1d ?? 0) >= 0 ? 'up' : 'down']}>
                    {fmtChange(p.change_1d)}
                  </span>
                  <span class="disclosure" aria-hidden="true">＋</span>
                </summary>
                <div class="detail-wrapper">
                  <div class="detail">
                    {p.description && <p class="description">{p.description}</p>}
                    <div class="detail-grid">
                      <div><span class="kicker">Категория</span><span>{p.category}</span></div>
                      <div><span class="kicker">Δ7 дней</span><span class:list={['data', (p.change_7d ?? 0) >= 0 ? 'up' : 'down']}>{fmtChange(p.change_7d)}</span></div>
                      <div><span class="kicker">Аудиты</span><span>{p.audits === '0' ? 'не найдены' : p.audits}</span></div>
                      {fmtListedDate(p.listedAt) && <div><span class="kicker">В реестре DeFiLlama с</span><span class="data">{fmtListedDate(p.listedAt)}</span></div>}
                      <div class="chains-list"><span class="kicker">Сети ({p.chains.length})</span><span>{p.chains.join(', ')}</span></div>
                    </div>
                    <div class="detail-links">
                      {p.url && <a href={p.url} target="_blank" rel="noopener">Сайт проекта ↗</a>}
                      {p.twitter && <a href={`https://x.com/${p.twitter}`} target="_blank" rel="noopener">X (Twitter) ↗</a>}
                      {p.auditLink && <a href={p.auditLink} target="_blank" rel="noopener">Отчёт аудита ↗</a>}
                      <a href={protocolPageUrl(p)} target="_blank" rel="noopener">Полная карточка на DeFiLlama ↗</a>
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>

        <p class="disclaimer kicker">
          Данные получены при последней сборке страницы. Не инвестиционная рекомендация.
        </p>
      </div>

      <aside class="side">
        {spotlight && (
          <SpotlightTeaser
            project={spotlight.data.project}
            tagline={spotlight.data.tagline}
            href={`/spotlight/${spotlight.id}/`}
            guestColor={spotlight.data.guestColor}
          />
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 24px 48px;
  }
  .crumbs {
    font-size: 13px;
    color: var(--graphite);
  }
  .crumbs a {
    color: var(--graphite);
    text-decoration: none;
  }
  .title {
    font-size: var(--step-h1);
    margin-top: 8px;
  }
  .intro {
    max-width: 68ch;
    color: var(--graphite);
    margin: 16px 0 24px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 16px;
    margin-bottom: 32px;
  }
  .stat {
    display: grid;
    gap: 6px;
  }
  .value {
    font-size: 22px;
    font-weight: 700;
  }
  .value a {
    color: var(--ink);
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
  }
  .block {
    margin-bottom: 32px;
  }
  .block-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }
  .block-head h2 {
    font-size: var(--step-h3);
  }
  .table-note {
    color: var(--graphite);
    margin: 0 0 8px;
  }
  .table {
    border-top: 1px solid var(--rule);
  }

  /* Shared row shell: both the plain <a> chain rows and the <details> protocol rows use the
     same grid so the three tables read as one visual system. */
  .row summary,
  a.row {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .row summary::-webkit-details-marker {
    display: none;
  }
  .table > .row {
    border-bottom: 1px solid var(--rule);
  }
  .proto-row > summary {
    grid-template-columns: 32px 1fr 80px 90px 64px 20px;
  }
  .chain-row {
    grid-template-columns: 32px 1fr auto 20px;
  }
  @media (hover: hover) and (pointer: fine) {
    .row summary:hover,
    a.row:hover {
      background: var(--paper);
    }
  }
  .rank {
    color: var(--graphite);
    font-size: 12px;
  }
  .proto {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .proto img {
    flex-shrink: 0;
  }
  .name {
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cat {
    flex-shrink: 0;
  }
  .chains {
    color: var(--graphite);
    font-size: 12px;
    white-space: nowrap;
  }
  .tvl {
    text-align: right;
    white-space: nowrap;
  }
  .chg {
    text-align: right;
    white-space: nowrap;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }
  .external,
  .disclosure {
    color: var(--graphite);
    font-size: 14px;
    text-align: center;
  }
  .proto-row[open] .disclosure {
    transform: rotate(45deg);
  }

  /* Accordion reveal: same technique as VerificationLog — the wrapper stays display:grid
     regardless of [open] (an author rule always beats the UA's
     "details:not([open]) > *:not(summary){display:none}"), and grid-template-rows 0fr→1fr
     does the actual show/hide without a layout jump. Exit (150ms) faster than entry (200ms),
     per the brief's motion table. */
  .detail-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 150ms var(--ease-standard), visibility 0s linear 150ms;
  }
  .proto-row[open] .detail-wrapper {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 200ms var(--ease-standard), visibility 0s linear 0s;
  }
  .detail {
    min-height: 0;
    overflow: hidden;
    padding: 4px 0 20px;
    display: grid;
    gap: 14px;
  }
  .description {
    margin: 0;
    color: var(--graphite);
    font-size: 14px;
    max-width: 64ch;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    border-top: 1px solid var(--rule);
    padding-top: 12px;
  }
  .detail-grid > div {
    display: grid;
    gap: 2px;
    font-size: 13px;
  }
  .chains-list {
    grid-column: 1 / -1;
  }
  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .detail-links a {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 3px;
  }
  .disclaimer {
    color: var(--graphite);
    margin-top: 16px;
  }
  .side {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    /* Same pattern as ArticleRow's mobile treatment: drop the least essential column
       (chains count) rather than fight a wide grid into a narrow viewport. */
    .proto-row > summary {
      grid-template-columns: 24px 1fr 70px 56px 16px;
    }
    .chains {
      display: none;
    }
    .detail-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
